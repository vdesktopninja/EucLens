<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- Semantic resources: keep keys identical in both themes. -->
 <Color x:Key="WindowColor">#F3F3F3</Color>
 <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
 <Color x:Key="SurfaceColor">#FFFFFF</Color>
 <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
 <Color x:Key="ElevatedColor">#F7F7F7</Color>
 <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource ElevatedColor}" />
 <Color x:Key="BorderColor">#D6D6D6</Color>
 <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
 <Color x:Key="TextColor">#202020</Color>
 <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
 <Color x:Key="MutedColor">#606060</Color>
 <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
 <Color x:Key="AccentColor">#165EA6</Color>
 <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
 <Color x:Key="AccentSurfaceColor">#E8F0F8</Color>
 <SolidColorBrush x:Key="AccentSurfaceBrush" Color="{StaticResource AccentSurfaceColor}" />
 <Color x:Key="SuccessColor">#18733B</Color>
 <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
 <Color x:Key="WarningColor">#875900</Color>
 <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
 <Color x:Key="CriticalColor">#B42318</Color>
 <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource CriticalColor}" />
 <Color x:Key="ChartGridColor">#E1E1E1</Color>
 <SolidColorBrush x:Key="ChartGridBrush" Color="{StaticResource ChartGridColor}" />
 <Color x:Key="ChartSecondaryColor">#627589</Color>
 <SolidColorBrush x:Key="ChartSecondaryBrush" Color="{StaticResource ChartSecondaryColor}" />
 <SolidColorBrush x:Key="ChartBackgroundBrush" Color="{StaticResource SurfaceColor}" />
</ResourceDictionary>
