<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- Semantic resources: keep keys identical in both themes. -->
 <Color x:Key="WindowColor">#202020</Color>
 <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
 <Color x:Key="SurfaceColor">#282828</Color>
 <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
 <Color x:Key="ElevatedColor">#303030</Color>
 <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource ElevatedColor}" />
 <Color x:Key="BorderColor">#484848</Color>
 <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
 <Color x:Key="TextColor">#F0F0F0</Color>
 <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
 <Color x:Key="MutedColor">#B8B8B8</Color>
 <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
 <Color x:Key="AccentColor">#79B8F3</Color>
 <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
 <Color x:Key="AccentSurfaceColor">#293F53</Color>
 <SolidColorBrush x:Key="AccentSurfaceBrush" Color="{StaticResource AccentSurfaceColor}" />
 <Color x:Key="SuccessColor">#7BC995</Color>
 <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
 <Color x:Key="WarningColor">#E4BC68</Color>
 <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
 <Color x:Key="CriticalColor">#F28B82</Color>
 <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource CriticalColor}" />
 <Color x:Key="ChartGridColor">#424242</Color>
 <SolidColorBrush x:Key="ChartGridBrush" Color="{StaticResource ChartGridColor}" />
 <Color x:Key="ChartSecondaryColor">#AFBDCD</Color>
 <SolidColorBrush x:Key="ChartSecondaryBrush" Color="{StaticResource ChartSecondaryColor}" />
 <SolidColorBrush x:Key="ChartBackgroundBrush" Color="{StaticResource SurfaceColor}" />
</ResourceDictionary>
