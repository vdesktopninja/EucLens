<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style TargetType="Window"><Setter Property="UseLayoutRounding" Value="True" /><Setter Property="SnapsToDevicePixels" Value="True" /><Setter Property="FontFamily" Value="{StaticResource BodyFont}" /><Setter Property="FontSize" Value="{StaticResource BodyFontSize}" /><Setter Property="Background" Value="{DynamicResource WindowBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
 <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
 <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="FontSize" Value="{StaticResource LabelFontSize}" /></Style>
 <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="{StaticResource HeadingFontSize}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,8" /></Style>
 <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="{StaticResource SectionFontSize}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="{StaticResource SectionMargin}" /></Style>
 <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="{StaticResource Hairline}" /><Setter Property="CornerRadius" Value="{StaticResource PanelRadius}" /><Setter Property="Padding" Value="{StaticResource PanelPadding}" /><Setter Property="Margin" Value="{StaticResource PanelMargin}" /></Style>
 <Style TargetType="Button"><Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
  <Setter Property="Background" Value="{DynamicResource ElevatedBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="{StaticResource Hairline}" /><Setter Property="Padding" Value="{StaticResource ControlPadding}" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Margin" Value="0,0,8,0" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource AccentSurfaceBrush}" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
 <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Padding" Value="{StaticResource ControlPadding}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource AccentSurfaceBrush}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ComboBox">
  <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" /><Setter Property="MinWidth" Value="160" /><Setter Property="FontSize" Value="{StaticResource BodyFontSize}" /><Setter Property="Margin" Value="0,4,8,0" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Background" Value="{DynamicResource ElevatedBrush}" /><Setter Property="AutomationProperties.Name" Value="Selection" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
   <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" /></ControlTemplate></ToggleButton.Template></ToggleButton>
   <ContentPresenter Margin="12,4,32,4" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" VerticalAlignment="Center" IsHitTestVisible="False" />
   <TextBlock Text="⌄" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" />
   <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource PopupRadius}" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,4,0,0"><ScrollViewer MaxHeight="320"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer></Border></Popup>
  </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="TextBox"><Setter Property="MinHeight" Value="{StaticResource ControlHeight}" /><Setter Property="Margin" Value="0,4,8,0" /><Setter Property="Padding" Value="{StaticResource ControlPadding}" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FontSize" Value="{StaticResource BodyFontSize}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" /><Setter Property="Background" Value="{DynamicResource ElevatedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="{StaticResource Hairline}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlRadius}"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="Expander"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
   <ToggleButton x:Name="HeaderToggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalAlignment="Left" Cursor="Hand" AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Focus" Background="Transparent" BorderBrush="Transparent" BorderThickness="{StaticResource Hairline}" Padding="0,4"><StackPanel Orientation="Horizontal"><TextBlock x:Name="Glyph" Text="▸" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" /><ContentPresenter /></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Glyph" Property="Text" Value="▾" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
    <TextBlock Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" Foreground="{DynamicResource AccentBrush}" FontSize="{StaticResource BodyFontSize}" TextWrapping="Wrap" />
   </ToggleButton>
   <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="0,4,0,0" />
  </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="HealthValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
  <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  <Style.Triggers>
   <Trigger Property="Text" Value="Healthy"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></Trigger>
   <Trigger Property="Text" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></Trigger>
   <Trigger Property="Text" Value="Critical"><Setter Property="Foreground" Value="{DynamicResource CriticalBrush}" /></Trigger>
  </Style.Triggers>
 </Style>
 <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Margin" Value="0,8,0,8" /><Setter Property="FontSize" Value="{StaticResource BodyFontSize}" /></Style>
 <DataTemplate x:Key="MetricTemplate">
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Value}" FontSize="{StaticResource MetricFontSize}" Typography.NumeralAlignment="Tabular" FontWeight="SemiBold" Margin="0,4" TextWrapping="Wrap" /><TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" /></StackPanel></Border>
 </DataTemplate>
 <Style x:Key="MetricGrid" TargetType="ItemsControl"><Setter Property="ItemTemplate" Value="{StaticResource MetricTemplate}" /><Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></Setter.Value></Setter></Style>
 <Style x:Key="NavigationItem" TargetType="ListBoxItem">
  <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="Padding" Value="{StaticResource ControlPadding}" /><Setter Property="Margin" Value="0,4,0,0" /><Setter Property="MinHeight" Value="{StaticResource ControlHeight}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Nav" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource ControlRadius}" Background="Transparent"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Nav" Property="Background" Value="{DynamicResource AccentSurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Nav" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Nav" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter TargetName="Nav" Property="BorderThickness" Value="{StaticResource Hairline}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- Reusable technical readouts for the next view implementation step. -->
 <Style x:Key="MetricValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
  <Setter Property="FontSize" Value="{StaticResource MetricFontSize}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Typography.NumeralAlignment" Value="Tabular" />
 </Style>
 <Style x:Key="Panel" TargetType="Border" BasedOn="{StaticResource Card}" />
 <Style x:Key="ChartSurface" TargetType="Border" BasedOn="{StaticResource Panel}"><Setter Property="Background" Value="{DynamicResource ChartBackgroundBrush}" /></Style>
 <Style TargetType="ToolTip"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="{StaticResource Hairline}" /><Setter Property="Padding" Value="8" /></Style>
 <DataTemplate x:Key="MetricRowTemplate">
  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,4" ToolTip="{Binding Detail}">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" Margin="0,0,8,0" VerticalAlignment="Center" />
    <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Right" TextAlignment="Right" />
   </Grid>
  </Border>
 </DataTemplate>
 <Style x:Key="MetricRows" TargetType="ItemsControl"><Setter Property="ItemTemplate" Value="{StaticResource MetricRowTemplate}" /></Style>
 <DataTemplate x:Key="MetricStripTemplate">
  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8" ToolTip="{Binding Detail}">
   <StackPanel><TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Value}" Style="{StaticResource MetricValue}" TextWrapping="Wrap" /></StackPanel>
  </Border>
 </DataTemplate>
 <Style x:Key="MetricStrip" TargetType="ItemsControl"><Setter Property="ItemTemplate" Value="{StaticResource MetricStripTemplate}" /><Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></Setter.Value></Setter></Style>
 <Style x:Key="HealthText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
  <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  <Style.Triggers>
   <DataTrigger Binding="{Binding Monitor.Health}" Value="Healthy"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
   <DataTrigger Binding="{Binding Monitor.Health}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
   <DataTrigger Binding="{Binding Monitor.Health}" Value="Critical"><Setter Property="Foreground" Value="{DynamicResource CriticalBrush}" /></DataTrigger>
  </Style.Triggers>
 </Style>
 <!-- Diagnostics: compact technical tables, segmented filters and status markers. Colour only for Healthy / Warning / Critical. -->
 <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="{StaticResource SectionFontSize}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,16,0,6" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
 <Style x:Key="SubLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="{StaticResource BodyFontSize}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="Margin" Value="0,12,0,4" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
 <Style x:Key="Reading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="{StaticResource ReadingFontSize}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
 <Style x:Key="ReadingMuted" TargetType="TextBlock" BasedOn="{StaticResource Reading}"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
 <Style x:Key="Meta" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="{StaticResource MetaFontSize}" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
 <Style x:Key="ValueText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="{StaticResource ValueFontSize}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Typography.NumeralAlignment" Value="Tabular" /></Style>
 <!-- SeverityIcon: the one severity/state symbol of the Diagnostics page. Tag = Info | Warning | Critical | Healthy | Recovered | NoData (SeverityKind).
      Each kind has its own shape, so severity is never carried by colour alone; the text label always sits next to the icon (a WPF Path has no UI Automation peer, so screen readers read the label only). -->
 <Style x:Key="SeverityIcon" TargetType="Path"><Setter Property="Width" Value="{StaticResource SeverityIconSize}" /><Setter Property="Height" Value="{StaticResource SeverityIconSize}" /><Setter Property="Stretch" Value="None" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="IsHitTestVisible" Value="False" /><Setter Property="Focusable" Value="False" /><Setter Property="SnapsToDevicePixels" Value="False" />
  <Setter Property="Data" Value="{StaticResource SeverityGeometryNoData}" /><Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
  <Style.Triggers>
   <Trigger Property="Tag" Value="Info"><Setter Property="Data" Value="{StaticResource SeverityGeometryInfo}" /><Setter Property="Fill" Value="{DynamicResource AccentBrush}" /></Trigger>
   <Trigger Property="Tag" Value="Warning"><Setter Property="Data" Value="{StaticResource SeverityGeometryWarning}" /><Setter Property="Fill" Value="{DynamicResource WarningBrush}" /></Trigger>
   <Trigger Property="Tag" Value="Critical"><Setter Property="Data" Value="{StaticResource SeverityGeometryCritical}" /><Setter Property="Fill" Value="{DynamicResource CriticalBrush}" /></Trigger>
   <Trigger Property="Tag" Value="Healthy"><Setter Property="Data" Value="{StaticResource SeverityGeometryHealthy}" /><Setter Property="Fill" Value="{DynamicResource SuccessBrush}" /></Trigger>
   <Trigger Property="Tag" Value="Recovered"><Setter Property="Data" Value="{StaticResource SeverityGeometryRecovered}" /></Trigger>
  </Style.Triggers>
 </Style>
<!-- EventIcon: the one symbol of a timeline event. Tag = Incident | FindingInfo | FindingWarning | FindingCritical | FindingRecovered | Pause | Resume | Disconnect | Reconnect |
      Availability | DataLoss | Lock | Unlock | Start | End | Note | SessionChange | Other (HistoryEventKinds.IconTag). Each tag has its own shape; the kind is always written next to it. -->
 <Style x:Key="EventIcon" TargetType="Path"><Setter Property="Width" Value="{StaticResource SeverityIconSize}" /><Setter Property="Height" Value="{StaticResource SeverityIconSize}" /><Setter Property="Stretch" Value="None" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="IsHitTestVisible" Value="False" /><Setter Property="Focusable" Value="False" /><Setter Property="SnapsToDevicePixels" Value="False" />
  <Setter Property="Data" Value="{StaticResource EventGeometryOther}" /><Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
  <Style.Triggers>
   <Trigger Property="Tag" Value="Incident"><Setter Property="Data" Value="{StaticResource EventGeometryIncident}" /><Setter Property="Fill" Value="{DynamicResource AccentBrush}" /></Trigger>
   <Trigger Property="Tag" Value="FindingInfo"><Setter Property="Data" Value="{StaticResource SeverityGeometryInfo}" /><Setter Property="Fill" Value="{DynamicResource AccentBrush}" /></Trigger>
   <Trigger Property="Tag" Value="FindingWarning"><Setter Property="Data" Value="{StaticResource SeverityGeometryWarning}" /><Setter Property="Fill" Value="{DynamicResource WarningBrush}" /></Trigger>
   <Trigger Property="Tag" Value="FindingCritical"><Setter Property="Data" Value="{StaticResource SeverityGeometryCritical}" /><Setter Property="Fill" Value="{DynamicResource CriticalBrush}" /></Trigger>
   <Trigger Property="Tag" Value="FindingRecovered"><Setter Property="Data" Value="{StaticResource SeverityGeometryRecovered}" /></Trigger>
   <Trigger Property="Tag" Value="Pause"><Setter Property="Data" Value="{StaticResource EventGeometryPause}" /></Trigger>
   <Trigger Property="Tag" Value="Resume"><Setter Property="Data" Value="{StaticResource EventGeometryResume}" /></Trigger>
   <Trigger Property="Tag" Value="Disconnect"><Setter Property="Data" Value="{StaticResource EventGeometryDisconnect}" /><Setter Property="Fill" Value="{DynamicResource WarningBrush}" /></Trigger>
   <Trigger Property="Tag" Value="Reconnect"><Setter Property="Data" Value="{StaticResource EventGeometryReconnect}" /><Setter Property="Fill" Value="{DynamicResource SuccessBrush}" /></Trigger>
   <Trigger Property="Tag" Value="Availability"><Setter Property="Data" Value="{StaticResource EventGeometryAvailability}" /></Trigger>
   <Trigger Property="Tag" Value="DataLoss"><Setter Property="Data" Value="{StaticResource EventGeometryDataLoss}" /><Setter Property="Fill" Value="{DynamicResource CriticalBrush}" /></Trigger>
   <Trigger Property="Tag" Value="Lock"><Setter Property="Data" Value="{StaticResource EventGeometryLock}" /></Trigger>
   <Trigger Property="Tag" Value="Unlock"><Setter Property="Data" Value="{StaticResource EventGeometryUnlock}" /></Trigger>
   <Trigger Property="Tag" Value="Start"><Setter Property="Data" Value="{StaticResource EventGeometryStart}" /></Trigger>
   <Trigger Property="Tag" Value="End"><Setter Property="Data" Value="{StaticResource EventGeometryEnd}" /></Trigger>
   <Trigger Property="Tag" Value="Note"><Setter Property="Data" Value="{StaticResource EventGeometryNote}" /></Trigger>
   <Trigger Property="Tag" Value="SessionChange"><Setter Property="Data" Value="{StaticResource EventGeometrySessionChange}" /></Trigger>
  </Style.Triggers>
 </Style>
  <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  <Style.Triggers>
   <Trigger Property="Tag" Value="Healthy"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></Trigger>
   <Trigger Property="Tag" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></Trigger>
   <Trigger Property="Tag" Value="Critical"><Setter Property="Foreground" Value="{DynamicResource CriticalBrush}" /></Trigger>
  </Style.Triggers>
 </Style>
 <!-- A ListBox without its own ScrollViewer, so the page scrolls as one surface and the mouse wheel is never captured. -->
 <Style x:Key="TableList" TargetType="ListBox"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" /><Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
  <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></Setter.Value></Setter>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><Border Background="{TemplateBinding Background}"><ItemsPresenter /></Border></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="TableRow" TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Padding" Value="8,6" /><Setter Property="MinHeight" Value="{StaticResource FindingsRowHeight}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Focus" BorderBrush="Transparent" BorderThickness="{StaticResource Hairline}"><Border x:Name="Row" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><Grid><Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Background="Transparent" /><ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" /></Grid></Border></Border>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource ElevatedBrush}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSurfaceBrush}" /><Setter TargetName="Bar" Property="Background" Value="{DynamicResource AccentBrush}" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- Splitter between findings and evidence: a thin line that thickens on hover and shows keyboard focus. -->
 <Style x:Key="SplitterThumb" TargetType="Thumb"><Setter Property="Focusable" Value="True" /><Setter Property="IsTabStop" Value="True" /><Setter Property="Background" Value="Transparent" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="AutomationProperties.Name" Value="Resize findings and evidence panes" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="Hit" Background="Transparent"><Border x:Name="Line" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="2" /></Border>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Line" Property="Background" Value="{DynamicResource AccentBrush}" /></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Line" Property="Background" Value="{DynamicResource AccentBrush}" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Line" Property="Background" Value="{DynamicResource AccentBrush}" /><Setter TargetName="Hit" Property="Background" Value="{DynamicResource AccentSurfaceBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="SegmentItem" TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Padding" Value="10,4" /><Setter Property="Margin" Value="0,0,4,4" /><Setter Property="MinHeight" Value="28" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="Cursor" Value="Hand" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Segment" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{StaticResource Hairline}" CornerRadius="{StaticResource ControlRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" /></Border>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Segment" Property="Background" Value="{DynamicResource AccentSurfaceBrush}" /><Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Segment" Property="BorderThickness" Value="2" /><Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Segmented" TargetType="ListBox" BasedOn="{StaticResource TableList}"><Setter Property="ItemContainerStyle" Value="{StaticResource SegmentItem}" /><Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></Setter.Value></Setter></Style>
 <Style x:Key="ColumnHeader" TargetType="Button"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="FontSize" Value="{StaticResource BodyFontSize}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Body" Background="Transparent" BorderBrush="Transparent" BorderThickness="{StaticResource Hairline}" Padding="2"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
