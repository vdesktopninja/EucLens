<Window x:Class="EucLens.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EUC Lens · Demo session observability" Width="1380" Height="940" MinWidth="1000" MinHeight="700" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="228" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="18,28,18,20">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top"><TextBlock Text="◉  EUC Lens" FontSize="24" FontWeight="Bold" /><TextBlock Text="SESSION OBSERVABILITY" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="4,10,0,32" /></StackPanel>
    <StackPanel DockPanel.Dock="Bottom"><Border Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="8" Padding="12"><StackPanel><TextBlock Text="DEMO WORKSPACE" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="Synthetic metrics only. No live vendor collection." Style="{StaticResource Muted}" Margin="0,7,0,0" /></StackPanel></Border><TextBlock Text="MVP 0.1 · Local &amp; private" Style="{StaticResource Muted}" Margin="4,16,0,0" /></StackPanel>
    <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavigationItem}" AutomationProperties.Name="Main navigation">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /><TextBlock Text="{Binding Name}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,18">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding SelectedPage.Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding UpdatedAt}" Style="{StaticResource Muted}" Margin="0,4,0,0" /></StackPanel><Border Grid.Column="1" Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="20" Padding="16,8" VerticalAlignment="Center"><TextBlock Text="DEMO DATA · NOT LIVE MEASUREMENTS" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" /></Border></Grid>
   </Border>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24,16,24"><ContentControl Content="{Binding SelectedPage}" HorizontalContentAlignment="Stretch" /></ScrollViewer>
   <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,12"><TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite" /></Border>
  </Grid>
 </Grid>
</Window>
