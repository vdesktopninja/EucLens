<Window x:Class="EucLens.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EUC Lens — Session diagnostics" Width="1280" Height="740" MinWidth="760" MinHeight="420" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource NavigationWidth}" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8,16,8,12">
   <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="EUC Lens" FontSize="{StaticResource HeadingFontSize}" FontWeight="SemiBold" Margin="12,0,0,16" />
    <StackPanel DockPanel.Dock="Bottom" Margin="12,16,8,0"><TextBlock Text="Demo provider" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="Synthetic session metrics.&#10;Vendor collection unavailable." Style="{StaticResource Muted}" Margin="0,4,0,0" /></StackPanel>
    <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavigationItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Main navigation">
     <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /><TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,8"><WrapPanel><TextBlock Text="DEMO DATA · Synthetic measurements" Style="{StaticResource Muted}" Margin="0,0,16,0" /><TextBlock Text="{Binding UpdatedAt}" Style="{StaticResource Muted}" /></WrapPanel></Border>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="{StaticResource PagePadding}"><ContentControl Content="{Binding SelectedPage}" HorizontalContentAlignment="Stretch" /></ScrollViewer>
   <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8"><TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" MaxHeight="48" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" AutomationProperties.LiveSetting="Polite" /></Border>
  </Grid>
 </Grid>
</Window>
