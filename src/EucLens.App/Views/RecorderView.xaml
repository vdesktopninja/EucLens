<UserControl x:Class="EucLens.App.Views.RecorderView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
 <StackPanel><TextBlock Text="Capture the session story" Style="{StaticResource Heading}" /><TextBlock Text="Record timestamped demo snapshots locally. Export a stable snapshot while recording or save the full recording after stopping." Style="{StaticResource Muted}" Margin="0,0,0,20" />
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Monitor.RecordingState}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" /><Grid Margin="0,22,0,22"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Elapsed" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Monitor.RecordingDuration}" FontSize="32" FontWeight="SemiBold" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Collected samples" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Monitor.SampleCount}" FontSize="32" FontWeight="SemiBold" /></StackPanel></Grid>
   <WrapPanel><Button Content="●  Start recording" Command="{Binding Monitor.StartRecordingCommand}" Style="{StaticResource PrimaryButton}" /><Button Content="■  Stop" Command="{Binding Monitor.StopRecordingCommand}" /><Button Content="Export JSON" Command="{Binding Monitor.ExportJsonCommand}" /><Button Content="Export CSV" Command="{Binding Monitor.ExportCsvCommand}" /></WrapPanel>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Recorded connection history" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="DEMO RTT · latest 600 recorded samples · exports contain all collected samples" Style="{StaticResource Muted}" Margin="0,8,0,20" /><lvc:CartesianChart Series="{Binding Monitor.RecordingSeries}" XAxes="{Binding Monitor.RecordingTimeAxes}" YAxes="{Binding Monitor.RecordingAxes}" AnimationsSpeed="{Binding Monitor.ChartAnimation}" Height="300" /></StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Local storage &amp; limits" FontWeight="SemiBold" Margin="0,0,0,10" /><TextBlock Text="{Binding Monitor.RecordLimit}" Style="{StaticResource Muted}" /><TextBlock Text="Samples stay in memory until exported. Closing the app discards unexported data. Protocol and scenario changes are allowed during a recording; each sample preserves its protocol and workload. JSON preserves metric availability and metadata; CSV uses explicit Unavailable cells." Style="{StaticResource Muted}" Margin="0,10,0,0" /></StackPanel></Border>
 </StackPanel>
</UserControl>
