<UserControl x:Class="EucLens.App.Views.RecorderView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:EucLens.App.Presentation" xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
 <StackPanel>
  <TextBlock Text="Session recorder" Style="{StaticResource Heading}" />
  <TextBlock Text="Record timestamped demo snapshots. Export during recording or after stopping." Style="{StaticResource Muted}" Margin="0,0,0,12" />
  <Border Style="{StaticResource Panel}"><StackPanel>
   <WrapPanel Margin="0,0,0,8"><TextBlock Text="{Binding Monitor.RecordingState}" FontWeight="SemiBold" Margin="0,0,24,4" /><TextBlock Text="{Binding Monitor.RecordingDuration, StringFormat=Elapsed: {0}}" Typography.NumeralAlignment="Tabular" Margin="0,0,24,4" /><TextBlock Text="{Binding Monitor.SampleCount, StringFormat=Samples: {0}}" Typography.NumeralAlignment="Tabular" /></WrapPanel>
   <WrapPanel><Button Content="Start recording" Command="{Binding Monitor.StartRecordingCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,4" /><Button Content="Stop" Command="{Binding Monitor.StopRecordingCommand}" Margin="0,0,8,4" /><Button Content="Export JSON" Command="{Binding Monitor.ExportJsonCommand}" Margin="0,0,8,4" /><Button Content="Export CSV" Command="{Binding Monitor.ExportCsvCommand}" Margin="0,0,8,4" /></WrapPanel>
  </StackPanel></Border><Border Style="{StaticResource ChartSurface}"><StackPanel><TextBlock Text="Recorded connection history" FontWeight="SemiBold" /><TextBlock Text="RTT · ms · latest 600 samples · exports include the full recording" Style="{StaticResource Muted}" Margin="0,4,0,8" /><lvc:CartesianChart ui:LiveChart.Data="{Binding Monitor.RecordingChart}" AnimationsSpeed="{Binding Monitor.ChartAnimation}" Height="216" Background="{DynamicResource ChartBackgroundBrush}" ui:ChartTheme.Text="{DynamicResource MutedBrush}" ui:ChartTheme.Surface="{DynamicResource SurfaceBrush}" ui:ChartTheme.Grid="{DynamicResource ChartGridBrush}" ui:ChartTheme.Line="{DynamicResource AccentBrush}" AutomationProperties.Name="Recorded connection history history" /></StackPanel></Border>
  <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Storage and limits" FontWeight="SemiBold" Margin="0,0,0,8" /><TextBlock Text="{Binding Monitor.RecordLimit}" Style="{StaticResource Muted}" /><TextBlock Text="Samples remain in memory until exported. Closing the app discards unexported data. Each sample preserves its protocol and workload when selections change. JSON includes availability and metadata; CSV uses explicit Unavailable cells." Style="{StaticResource Muted}" Margin="0,8,0,0" /></StackPanel></Border>
 </StackPanel>
</UserControl>
