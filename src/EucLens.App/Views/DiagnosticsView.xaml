<UserControl x:Class="EucLens.App.Views.DiagnosticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:EucLens.App.Presentation">
 <StackPanel>
  <TextBlock Text="Diagnostics" Style="{StaticResource Heading}" />
  <TextBlock Text="Offline, rule-based analysis of measured values. A finding needs sustained evidence over the stated window; correlations are reported as possible contributors, not proven causes. Thresholds are tunable defaults (Settings)." Style="{StaticResource Muted}" Margin="0,0,0,12" />
  <ItemsControl ItemsSource="{Binding Monitor.HealthTiles}" AutomationProperties.Name="Domain health">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><ui:AdaptiveColumnsPanel MinimumColumnWidth="220" MaximumColumns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate>
    <Border Style="{StaticResource Panel}" ToolTip="{Binding CoverageNote}"><StackPanel>
     <TextBlock Text="{Binding Domain}" Style="{StaticResource Muted}" />
     <TextBlock Text="{Binding State}" Style="{StaticResource HealthValue}" FontSize="{StaticResource SectionFontSize}" Margin="0,4,0,2" />
     <TextBlock Text="{Binding Coverage}" Style="{StaticResource Muted}" />
     <TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" />
     <TextBlock Text="{Binding CoverageNote}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" />
    </StackPanel></Border>
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <Border Style="{StaticResource Panel}"><StackPanel>
   <TextBlock Text="Assessment" FontWeight="SemiBold" Margin="0,0,0,4" />
   <ItemsControl ItemsSource="{Binding Monitor.Hypotheses}" AutomationProperties.Name="Assessment"><ItemsControl.ItemTemplate><DataTemplate>
    <StackPanel Margin="0,4"><TextBlock Text="{Binding Statement}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Confidence}" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Verification}" Style="{StaticResource Muted}" FontSize="12" /></StackPanel>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></Border>
  <WrapPanel Margin="0,0,0,4">
   <StackPanel Margin="0,0,0,8"><TextBlock Text="Show" Style="{StaticResource Muted}" /><ComboBox Width="160" ItemsSource="{Binding Monitor.FindingFilters}" SelectedItem="{Binding Monitor.SelectedFindingFilter}" DisplayMemberPath="Label" AutomationProperties.Name="Finding severity filter" /></StackPanel>
   <StackPanel Margin="0,0,16,8"><TextBlock Text="Workload (user-selected)" Style="{StaticResource Muted}" /><ComboBox Width="200" ItemsSource="{Binding Monitor.Workloads}" SelectedItem="{Binding Monitor.SelectedWorkload}" DisplayMemberPath="Label" AutomationProperties.Name="Diagnostic workload context" /></StackPanel>
   <TextBlock Text="{Binding Monitor.FindingSummary}" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,14" AutomationProperties.LiveSetting="Polite" />
  </WrapPanel>
  <ItemsControl ItemsSource="{Binding Monitor.FindingCards}" AutomationProperties.Name="Findings"><ItemsControl.ItemTemplate><DataTemplate>
   <Border Style="{StaticResource Panel}"><StackPanel>
    <WrapPanel Margin="0,0,0,4"><TextBlock Text="{Binding Severity}" FontWeight="SemiBold" FontSize="12" Margin="0,2,12,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Severity}" Value="WARNING"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger><DataTrigger Binding="{Binding Severity}" Value="CRITICAL"><Setter Property="Foreground" Value="{DynamicResource CriticalBrush}" /></DataTrigger><DataTrigger Binding="{Binding Severity}" Value="INFO"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" Margin="0,0,12,0" /><TextBlock Text="{Binding Domain}" Style="{StaticResource Muted}" Margin="0,2,0,0" /></WrapPanel>
    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,4" />
    <TextBlock Text="{Binding Metrics}" Style="{StaticResource Muted}" Typography.NumeralAlignment="Tabular" />
    <TextBlock Style="{StaticResource Muted}" FontSize="11"><Run Text="{Binding Window, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Timeline, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding RuleId, Mode=OneWay}" /></TextBlock>
    <Expander Header="Evidence, decision rule and recommended actions" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,4,0,0"><StackPanel>
     <Border Background="{DynamicResource ElevatedBrush}" Padding="8" Margin="0,0,0,8"><TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" Typography.NumeralAlignment="Tabular" FontSize="12" /></Border>
     <TextBlock Text="Decision rule" Style="{StaticResource Muted}" /><TextBlock Text="{Binding DecisionRule}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,8" />
     <ui:AdaptiveColumnsPanel MinimumColumnWidth="280" MaximumColumns="2"><StackPanel Margin="0,0,12,8"><TextBlock Text="Possible causes" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Causes}" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel><StackPanel Margin="0,0,0,8"><TextBlock Text="Recommended actions" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Actions}" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel></ui:AdaptiveColumnsPanel>
     <TextBlock Text="Data quality and limitations" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Limitations}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
    </StackPanel></Expander>
   </StackPanel></Border>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </StackPanel>
</UserControl>
