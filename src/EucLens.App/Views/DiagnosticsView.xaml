<UserControl x:Class="EucLens.App.Views.DiagnosticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:EucLens.App.Presentation" xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
 <StackPanel>
  <TextBlock Text="Diagnostics" Style="{StaticResource Heading}" />
  <TextBlock Text="Connection rules evaluate each sample. Host rules (CPU, memory, GPU, VRAM, encoder) need a full 30-sample window with 80 % of samples over the threshold, so short spikes are ignored. Thresholds are starting points, not vendor guidance." Style="{StaticResource Muted}" Margin="0,0,0,12" />
  <Border Style="{StaticResource Panel}"><WrapPanel><StackPanel Margin="0,0,24,8"><TextBlock Text="Connection health" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Monitor.ConnectionHealth}" Style="{StaticResource HealthValue}" Margin="0,8,0,0" /></StackPanel><StackPanel Margin="0,0,24,8"><TextBlock Text="System / host performance" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Monitor.HostHealth}" Style="{StaticResource HealthValue}" Margin="0,8,0,0" /></StackPanel><StackPanel Margin="0,0,0,8"><TextBlock Text="Workload" Style="{StaticResource Muted}" /><ComboBox Width="200" ItemsSource="{Binding Monitor.Workloads}" SelectedItem="{Binding Monitor.SelectedWorkload}" DisplayMemberPath="Label" AutomationProperties.Name="Diagnostic workload context" /></StackPanel></WrapPanel></Border>
  <ItemsControl ItemsSource="{Binding Monitor.DiagnosticCards}"><ItemsControl.ItemTemplate><DataTemplate>
   <Border Style="{StaticResource Panel}"><StackPanel>
    <WrapPanel Margin="0,0,0,8"><TextBlock Text="{Binding Severity}" FontWeight="SemiBold" FontSize="12" Margin="0,2,12,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Severity}" Value="WARNING"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger><DataTrigger Binding="{Binding Severity}" Value="CRITICAL"><Setter Property="Foreground" Value="{DynamicResource CriticalBrush}" /></DataTrigger><DataTrigger Binding="{Binding Severity}" Value="INFO"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" /></WrapPanel>
    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,8" />
    <Border Background="{DynamicResource ElevatedBrush}" Padding="8" Margin="0,0,0,8"><TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" Typography.NumeralAlignment="Tabular" FontSize="12" /></Border>
    <ui:AdaptiveColumnsPanel MinimumColumnWidth="300" MaximumColumns="2"><StackPanel Margin="0,0,12,0"><TextBlock Text="Possible cause" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Cause}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel><StackPanel><TextBlock Text="Recommended action" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Action}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel></ui:AdaptiveColumnsPanel>
   </StackPanel></Border>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </StackPanel>
</UserControl>
