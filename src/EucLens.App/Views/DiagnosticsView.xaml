<UserControl x:Class="EucLens.App.Views.DiagnosticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel><TextBlock Text="Understand the signals" Style="{StaticResource Heading}" /><TextBlock Text="Four sample rules evaluate DEMO DATA every second. These thresholds are examples, not vendor guidance. Single-sample findings need correlation over time." Style="{StaticResource Muted}" Margin="0,0,12,20" />
  <Border Style="{StaticResource Card}"><WrapPanel><StackPanel Margin="0,0,24,0"><TextBlock Text="Health assessment" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Monitor.Health}" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel><StackPanel><TextBlock Text="Workload context" Style="{StaticResource Muted}" /><ComboBox ItemsSource="{Binding Monitor.Workloads}" SelectedItem="{Binding Monitor.SelectedWorkload}" DisplayMemberPath="Label" AutomationProperties.Name="Diagnostic workload context" /></StackPanel></WrapPanel></Border>
  <ItemsControl ItemsSource="{Binding Monitor.DiagnosticCards}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><StackPanel>
   <TextBlock Text="{Binding Severity}" FontSize="11" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Severity}" Value="WARNING"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger><DataTrigger Binding="{Binding Severity}" Value="CRITICAL"><Setter Property="Foreground" Value="#ED7373" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,8" /><TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
   <Border Background="{DynamicResource ElevatedBrush}" CornerRadius="6" Padding="12" Margin="0,14,0,14"><TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" FontSize="12" /></Border>
   <TextBlock Text="POSSIBLE CAUSE" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Cause}" TextWrapping="Wrap" Margin="0,5,0,12" /><TextBlock Text="RECOMMENDED ACTION" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Action}" TextWrapping="Wrap" Margin="0,5,0,0" />
  </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </StackPanel>
</UserControl>
