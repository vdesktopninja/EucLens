<UserControl x:Class="EucLens.App.Views.SystemView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:EucLens.App.Presentation" xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
 <StackPanel>
  <TextBlock Text="System information" Style="{StaticResource Heading}" />
  <TextBlock Text="{Binding Monitor.ModeDescription}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
  <Border Style="{StaticResource ChartSurface}"><StackPanel><TextBlock Text="CPU utilization (machine-wide)" FontWeight="SemiBold" /><TextBlock Text="CPU · % · 120 samples · 1 Hz · gaps mark unavailable samples" Style="{StaticResource Muted}" Margin="0,4,0,8" /><lvc:CartesianChart ui:LiveChart.Data="{Binding Monitor.CpuChart}" AnimationsSpeed="{Binding Monitor.ChartAnimation}" Height="{StaticResource ChartHeight}" Background="{DynamicResource ChartBackgroundBrush}" ui:ChartTheme.Text="{DynamicResource MutedBrush}" ui:ChartTheme.Surface="{DynamicResource SurfaceBrush}" ui:ChartTheme.Grid="{DynamicResource ChartGridBrush}" ui:ChartTheme.Line="{DynamicResource AccentBrush}" AutomationProperties.Name="CPU utilization history" /></StackPanel></Border>
  <ui:AdaptiveColumnsPanel MinimumColumnWidth="300" MaximumColumns="2"><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Session" FontWeight="SemiBold" Margin="0,0,0,8" /><ItemsControl ItemsSource="{Binding Monitor.SessionCards}" Style="{StaticResource MetricRows}" /></StackPanel></Border><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="GPU" FontWeight="SemiBold" Margin="0,0,0,8" /><ItemsControl ItemsSource="{Binding Monitor.GpuCards}" Style="{StaticResource MetricRows}" /></StackPanel></Border><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Graphics" FontWeight="SemiBold" Margin="0,0,0,8" /><ItemsControl ItemsSource="{Binding Monitor.GraphicsCards}" Style="{StaticResource MetricRows}" /></StackPanel></Border><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="System resources" FontWeight="SemiBold" Margin="0,0,0,8" /><ItemsControl ItemsSource="{Binding Monitor.SystemCards}" Style="{StaticResource MetricRows}" /></StackPanel></Border></ui:AdaptiveColumnsPanel>
  <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Data sources" FontWeight="SemiBold" /><TextBlock Text="Real Session reads Horizon Blast counters for this Windows session, Windows CPU/memory/disk APIs, DXGI and GPU performance counters, NVIDIA NVML when the driver provides it, and the display configuration of this session's desktop. Citrix HDX and Microsoft RDP protocol metrics are not implemented. No administrator rights, WMI polling or network access are used. See Advanced Metrics for every source." Style="{StaticResource Muted}" Margin="0,8,0,0" /></StackPanel></Border>
 </StackPanel>
</UserControl>
