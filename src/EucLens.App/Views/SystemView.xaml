<UserControl x:Class="EucLens.App.Views.SystemView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel><TextBlock Text="Session &amp; system inventory" Style="{StaticResource Heading}" /><TextBlock Text="All values below describe the simulated session. They are not measurements of this computer." Style="{StaticResource Muted}" Margin="0,0,0,12" />
  <TextBlock Text="Demo session" Style="{StaticResource Section}" /><ItemsControl ItemsSource="{Binding Monitor.SessionCards}" Style="{StaticResource MetricGrid}" />
  <TextBlock Text="Demo GPU" Style="{StaticResource Section}" /><ItemsControl ItemsSource="{Binding Monitor.GpuCards}" Style="{StaticResource MetricGrid}" />
  <TextBlock Text="Demo system metrics" Style="{StaticResource Section}" /><ItemsControl ItemsSource="{Binding Monitor.SystemCards}" Style="{StaticResource MetricGrid}" />
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Real integrations: Unavailable" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Citrix HDX, Omnissa Horizon Blast, Microsoft RDP and NVIDIA NVML adapters are research placeholders. No vendor SDK, performance counter, registry or WMI collection is implemented. No privileges are requested." Style="{StaticResource Muted}" Margin="0,12,0,0" /></StackPanel></Border>
 </StackPanel>
</UserControl>
