<UserControl x:Class="EucLens.App.Views.SystemView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:EucLens.App.Presentation" xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
 <StackPanel>
  <TextBlock Text="System information" Style="{StaticResource Heading}" />
  <TextBlock Text="Simulated inventory; these values do not describe this computer." Style="{StaticResource Muted}" Margin="0,0,0,12" />
  <ui:AdaptiveColumnsPanel MinimumColumnWidth="300" MaximumColumns="2"><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Session" FontWeight="SemiBold" Margin="0,0,0,8" /><ItemsControl ItemsSource="{Binding Monitor.SessionCards}" Style="{StaticResource MetricRows}" /></StackPanel></Border><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="GPU" FontWeight="SemiBold" Margin="0,0,0,8" /><ItemsControl ItemsSource="{Binding Monitor.GpuCards}" Style="{StaticResource MetricRows}" /></StackPanel></Border><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Graphics" FontWeight="SemiBold" Margin="0,0,0,8" /><ItemsControl ItemsSource="{Binding Monitor.GraphicsCards}" Style="{StaticResource MetricRows}" /></StackPanel></Border><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="System resources" FontWeight="SemiBold" Margin="0,0,0,8" /><ItemsControl ItemsSource="{Binding Monitor.SystemCards}" Style="{StaticResource MetricRows}" /></StackPanel></Border></ui:AdaptiveColumnsPanel>
  <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Vendor integrations · Unavailable" FontWeight="SemiBold" /><TextBlock Text="Citrix HDX, Omnissa Horizon Blast, Microsoft RDP and NVIDIA NVML adapters are research placeholders. No vendor SDK, performance counter, registry or WMI collection is implemented. No privileges are requested." Style="{StaticResource Muted}" Margin="0,8,0,0" /></StackPanel></Border>
 </StackPanel>
</UserControl>
