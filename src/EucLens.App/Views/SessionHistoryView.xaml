<UserControl x:Class="EucLens.App.Views.SessionHistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:EucLens.App.Presentation" xmlns:vmtypes="clr-namespace:EucLens.App.ViewModels" xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
 <UserControl.Resources>
  <!-- A note that takes no space while it is empty. -->
  <Style x:Key="HideWhenEmpty" TargetType="TextBlock" BasedOn="{StaticResource Meta}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style>
  <Style x:Key="HideWhenEmptyReading" TargetType="TextBlock" BasedOn="{StaticResource ReadingMuted}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style>
  <!-- Small buttons for the export area: the page's actions are secondary to its findings. -->
  <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="26" /><Setter Property="Padding" Value="8,1" /><Setter Property="Margin" Value="0,0,4,0" /><Setter Property="FontSize" Value="{StaticResource MetaFontSize}" /></Style>
  <!-- Shown only while nothing is selected. -->
  <Style x:Key="WhenNothingSelected" TargetType="TextBlock" BasedOn="{StaticResource Meta}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>

  <!-- One tile of the recording overview. -->
  <DataTemplate x:Key="OverviewTile">
   <Border Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{StaticResource Hairline}" CornerRadius="{StaticResource ControlRadius}" Padding="10,6" Margin="0,0,8,8" ToolTip="{Binding ToolTip}" ToolTipService.IsEnabled="{Binding HasToolTip}" AutomationProperties.Name="{Binding AutomationName}">
    <StackPanel>
     <TextBlock Text="{Binding Label}" Style="{StaticResource Meta}" />
     <StackPanel Orientation="Horizontal"><Path Style="{StaticResource SeverityIcon}" Tag="{Binding Icon}" Margin="0,0,6,0" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" /><TextBlock Text="{Binding Value}" FontSize="{StaticResource StateFontSize}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" TextWrapping="Wrap" VerticalAlignment="Center" /></StackPanel>
     <TextBlock Text="{Binding Detail}" Style="{StaticResource Meta}" Typography.NumeralAlignment="Tabular" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
   </Border>
  </DataTemplate>

  <!-- The three kinds of line of the findings list. Severity is the icon and its word; the measured value that matters is on the right. -->
  <DataTemplate x:Key="SingleFindingRow">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <Path Style="{StaticResource SeverityIcon}" Tag="{Binding SeverityTag}" VerticalAlignment="Top" Margin="0,2,10,0" />
    <StackPanel Grid.Column="1">
     <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{StaticResource ReadingFontSize}" TextWrapping="Wrap" />
     <TextBlock Style="{StaticResource Meta}" Typography.NumeralAlignment="Tabular"><Run Text="{Binding SeverityLabel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Time, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Duration, Mode=OneWay}" /></TextBlock>
     <TextBlock Text="{Binding StatusBadge}" Style="{StaticResource Meta}" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding HasStatusBadge, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
    <StackPanel Grid.Column="2" Margin="12,0,0,0" MinWidth="72"><TextBlock Text="{Binding KeyValue}" Style="{StaticResource ValueText}" TextAlignment="Right" /><TextBlock Text="{Binding KeyLabel}" Style="{StaticResource Meta}" TextAlignment="Right" /></StackPanel>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="GroupFindingRow">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <!-- The chevron is a real button: the mouse and assistive technology invoke it. It is not a tab stop; the keyboard uses Right, Left and Enter on the selected line. -->
    <Button Command="{Binding ToggleCommand}" Focusable="False" IsTabStop="False" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,0" Width="16" Height="22" MinHeight="0" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{Binding ToggleName}" ToolTip="Open or close the occurrences">
     <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Button.Template>
     <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="{StaticResource MetaFontSize}">
      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="▸" /><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Text" Value="▾" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
    </Button>
    <Path Grid.Column="1" Style="{StaticResource SeverityIcon}" Tag="{Binding SeverityTag}" VerticalAlignment="Top" Margin="0,2,10,0" />
    <StackPanel Grid.Column="2">
     <WrapPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{StaticResource ReadingFontSize}" TextWrapping="Wrap" />
      <Border Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="9" Padding="7,0" Margin="8,1,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding CountText}" Style="{StaticResource Meta}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" TextWrapping="NoWrap" /></Border></WrapPanel>
     <TextBlock Style="{StaticResource Meta}" Typography.NumeralAlignment="Tabular"><Run Text="{Binding SeverityLabel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Time, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding TotalText, Mode=OneWay}" /></TextBlock>
     <TextBlock Text="{Binding StatusBadge}" Style="{StaticResource Meta}" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding HasStatusBadge, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
    <StackPanel Grid.Column="3" Margin="12,0,0,0" MinWidth="72"><TextBlock Text="{Binding KeyValue}" Style="{StaticResource ValueText}" TextAlignment="Right" /><TextBlock Text="{Binding KeyLabel}" Style="{StaticResource Meta}" TextAlignment="Right" /></StackPanel>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="OccurrenceFindingRow">
   <Grid Margin="30,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <Path Style="{StaticResource SeverityIcon}" Tag="{Binding SeverityTag}" VerticalAlignment="Top" Margin="0,1,10,0" />
    <StackPanel Grid.Column="1">
     <TextBlock Style="{StaticResource Reading}" Typography.NumeralAlignment="Tabular"><Run Text="{Binding Time, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  " Foreground="{DynamicResource MutedBrush}" /><Run Text="{Binding Duration, Mode=OneWay}" /></TextBlock>
     <TextBlock Text="{Binding SeverityLabel}" Style="{StaticResource Meta}" />
     <TextBlock Text="{Binding StatusBadge}" Style="{StaticResource Meta}" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding HasStatusBadge, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
    <StackPanel Grid.Column="2" Margin="12,0,0,0" MinWidth="72"><TextBlock Text="{Binding KeyValue}" Style="{StaticResource ValueText}" TextAlignment="Right" /><TextBlock Text="{Binding KeyLabel}" Style="{StaticResource Meta}" TextAlignment="Right" /></StackPanel>
   </Grid>
  </DataTemplate>
  <Style x:Key="FindingRowSwitch" TargetType="ContentControl">
   <Setter Property="ContentTemplate" Value="{StaticResource SingleFindingRow}" />
   <Setter Property="Focusable" Value="False" />
   <Style.Triggers>
    <DataTrigger Binding="{Binding Kind}" Value="Group"><Setter Property="ContentTemplate" Value="{StaticResource GroupFindingRow}" /></DataTrigger>
    <DataTrigger Binding="{Binding Kind}" Value="Occurrence"><Setter Property="ContentTemplate" Value="{StaticResource OccurrenceFindingRow}" /></DataTrigger>
   </Style.Triggers>
  </Style>
 </UserControl.Resources>
 <!-- Session History. DataContext: SessionHistoryPage. One recording at a time: a compact overview, the performance timeline, the findings (grouped by rule, with the selected one's evidence beside
      the list), range controls, charts that share one time axis, then the event list and the selected incident. Nothing here touches the live view or the sampling loop. -->
 <StackPanel>
  <TextBlock Text="Session history" Style="{StaticResource Heading}" Margin="0,0,0,2" />
  <TextBlock Text="Measured findings, the measurements around them and what the user marked, read from the recording on this computer." Style="{StaticResource Muted}" Margin="0,0,0,8" />

  <Border Style="{StaticResource Panel}" AutomationProperties.Name="Recording selection"><StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <ComboBox ItemsSource="{Binding Monitor.History.Recordings}" SelectedItem="{Binding Monitor.History.SelectedRecording}" AutomationProperties.Name="Saved recording" HorizontalAlignment="Stretch" Margin="0,0,8,0">
     <ComboBox.ItemTemplate><DataTemplate><TextBlock Typography.NumeralAlignment="Tabular"><Run Text="{Binding Started, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  " /><Run Text="{Binding Duration, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Samples, Mode=OneWay}" /><Run Text=" samples  ·  " /><Run Text="{Binding Summary.Incidents, Mode=OneWay}" /><Run Text=" incident(s)  ·  " /><Run Text="{Binding Status, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" /></TextBlock></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="Refresh list" Command="{Binding Monitor.History.RefreshRecordingsCommand}" Margin="0,0,8,0" /><Button Content="Open folder" Command="{Binding Monitor.History.OpenFolderCommand}" /></StackPanel>
   </Grid>
   <TextBlock Text="{Binding Monitor.History.Message}" Style="{StaticResource Meta}" Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="History status" />
   <TextBlock Text="{Binding Monitor.History.LoadProgress}" Style="{StaticResource Meta}" TextWrapping="Wrap" Typography.NumeralAlignment="Tabular" Visibility="{Binding Monitor.History.IsLoading, Converter={StaticResource BoolToVisibility}}" />
   <TextBlock Text="{Binding Monitor.History.Error}" Foreground="{DynamicResource CriticalBrush}" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="{Binding Monitor.History.HasError, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="Recording error" />
  </StackPanel></Border>

  <StackPanel Visibility="{Binding Monitor.History.HasHistory, Converter={StaticResource BoolToVisibility}}">
   <!-- Overview: eight tiles; the secondary facts and the recording's identifier are one expander away. -->
   <Border Style="{StaticResource Panel}" AutomationProperties.Name="Recording overview"><StackPanel>
    <ItemsControl ItemsSource="{Binding Monitor.History.Tiles}" ItemTemplate="{StaticResource OverviewTile}" Focusable="False" AutomationProperties.Name="Recording summary: date, duration, protocol, status, samples, data coverage, findings and incidents">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><ui:AdaptiveColumnsPanel MinimumColumnWidth="128" MaximumColumns="8" BalanceRows="True" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    </ItemsControl>
    <Border BorderBrush="{DynamicResource WarningBrush}" BorderThickness="2,0,0,0" Padding="8,2,0,2" Margin="0,0,0,8" Visibility="{Binding Monitor.History.IsPartial, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Partial analysis notice"><TextBlock Text="{Binding Monitor.History.PartialNote}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /></Border>
    <ItemsControl ItemsSource="{Binding Monitor.History.IssueLines}" Focusable="False" Visibility="{Binding Monitor.History.HasIssues, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Reading notes"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Reading}" Margin="0,0,0,4" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Expander Header="Recording details" AutomationProperties.Name="Recording details">
     <StackPanel>
      <TextBlock Text="{Binding Monitor.History.StateNote}" Style="{StaticResource Meta}" Margin="0,2,0,0" />
      <TextBlock Text="{Binding Monitor.History.CompactSummary}" Style="{StaticResource Meta}" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0" AutomationProperties.Name="Recording summary" />
      <ItemsControl ItemsSource="{Binding Monitor.History.Facts}" Focusable="False" Margin="0,6,0,0" AutomationProperties.Name="Recording facts">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate><StackPanel Width="230" Margin="0,0,16,8" AutomationProperties.Name="{Binding Label}"><TextBlock Text="{Binding Label}" Style="{StaticResource Meta}" /><TextBlock Text="{Binding Value}" Style="{StaticResource ValueText}" TextWrapping="Wrap" /><TextBlock Text="{Binding Detail}" Style="{StaticResource Meta}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding Monitor.History.UnavailableNote}" Style="{StaticResource Meta}" Margin="0,2,0,0" Visibility="{Binding Monitor.History.HasUnavailableNote, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock Text="{Binding Monitor.History.ZoneNote}" Style="{StaticResource Meta}" Margin="0,2,0,0" />
     </StackPanel>
    </Expander>
   </StackPanel></Border>

   <!-- Performance timeline: every finding at its recorded interval on the track of its area, the recording's gaps in a row of their own. A click selects the finding (and so moves the charts). -->
   <Border Style="{StaticResource Panel}" AutomationProperties.Name="Performance timeline"><StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <TextBlock Text="Performance timeline" FontWeight="SemiBold" FontSize="{StaticResource ReadingFontSize}" />
     <StackPanel Grid.Column="1" Orientation="Horizontal" AutomationProperties.Name="Timeline legend">
      <StackPanel Orientation="Horizontal" Margin="0,0,12,0"><Border Width="12" Height="12" Background="{DynamicResource CriticalBrush}" Margin="0,0,4,0" VerticalAlignment="Center" /><TextBlock Text="Critical" Style="{StaticResource Meta}" VerticalAlignment="Center" /></StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,12,0"><Border Width="12" Height="9" Background="{DynamicResource WarningBrush}" Margin="0,0,4,0" VerticalAlignment="Center" /><TextBlock Text="Warning" Style="{StaticResource Meta}" VerticalAlignment="Center" /></StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,12,0"><Border Width="12" Height="6" Background="{DynamicResource AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center" /><TextBlock Text="Info" Style="{StaticResource Meta}" VerticalAlignment="Center" /></StackPanel>
      <StackPanel Orientation="Horizontal"><Border Width="12" Height="9" Background="{DynamicResource MutedBrush}" Margin="0,0,4,0" VerticalAlignment="Center" /><TextBlock Text="No samples" Style="{StaticResource Meta}" VerticalAlignment="Center" /></StackPanel>
     </StackPanel>
    </Grid>
    <ui:FindingsTimeline x:Name="PerformanceTimeline" Margin="0,6,0,0" SessionStart="{Binding Monitor.History.SessionStart, Mode=OneWay}" SessionEnd="{Binding Monitor.History.SessionEnd, Mode=OneWay}" ViewStart="{Binding Monitor.History.ViewStart, Mode=OneWay}" ViewEnd="{Binding Monitor.History.ViewEnd, Mode=OneWay}" Gaps="{Binding Monitor.History.Gaps, Mode=OneWay}" Zone="{Binding Monitor.History.Zone, Mode=OneWay}" Bars="{Binding Monitor.History.Findings.TimelineBars, Mode=OneWay}" SelectedId="{Binding Monitor.History.Findings.TimelineSelectedId, Mode=OneWay}" HighlightIds="{Binding Monitor.History.Findings.TimelineHighlightIds, Mode=OneWay}" AutomationProperties.Name="{Binding Monitor.History.Findings.TimelineAutomationName}" ToolTipService.ShowDuration="20000" />
   </StackPanel></Border>

   <!-- Performance findings. DataContext of the inner panel: the findings view model. Findings are measured conditions, not causes; selecting one moves every chart to its
        real interval (the page never scrolls on its own while arrow keys move through the list). -->
   <Border Style="{StaticResource Panel}" AutomationProperties.Name="Performance findings"><StackPanel x:Name="FindingsPanel" DataContext="{Binding Monitor.History.Findings}">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="Performance findings" FontWeight="SemiBold" FontSize="{StaticResource ReadingFontSize}" />
      <TextBlock Text="{Binding Summary}" Style="{StaticResource Meta}" Typography.NumeralAlignment="Tabular" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Findings summary" />
      <WrapPanel Margin="0,4,0,0"><Button Content="Show full recording" Style="{StaticResource CompactButton}" Command="{Binding ShowFullRecordingCommand}" AutomationProperties.Name="Show full recording" ToolTip="Clear the selected finding and show the whole recording (Escape in the findings list)" /></WrapPanel>
     </StackPanel>
     <!-- All the optional files in one labelled place. -->
     <StackPanel Grid.Column="1" Margin="12,0,0,0" AutomationProperties.Name="Export">
      <TextBlock Text="Export" Style="{StaticResource Meta}" />
      <WrapPanel>
       <Button Content="Findings CSV" Style="{StaticResource CompactButton}" Command="{Binding DataContext.Monitor.History.ExportFindingsCsvCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" AutomationProperties.Name="Export findings as CSV" ToolTip="Optional file: every observation and correlation with its evidence, UTC times and recorded units. Text cells are protected against spreadsheet formulas." />
       <Button Content="Findings JSON" Style="{StaticResource CompactButton}" Command="{Binding DataContext.Monitor.History.ExportFindingsJsonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" AutomationProperties.Name="Export findings as JSON" ToolTip="Optional file: the complete analysis in a versioned structure (euclens.findings/1)." />
       <Button Content="Incidents CSV" Style="{StaticResource CompactButton}" Command="{Binding DataContext.Monitor.History.ExportIncidentsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" AutomationProperties.Name="Export incidents as CSV" ToolTip="Optional separate file: marked incidents with their annotations. The session CSV and JSON exports are unchanged." />
       <Button Content="Timeline CSV" Style="{StaticResource CompactButton}" Command="{Binding DataContext.Monitor.History.ExportTimelineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" AutomationProperties.Name="Export timeline as CSV" ToolTip="Optional separate file: every timeline entry." />
      </WrapPanel>
     </StackPanel>
    </Grid>
    <TextBlock Text="{Binding ExportMessage}" Style="{StaticResource HideWhenEmpty}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Findings export result" />
    <TextBlock Text="{Binding Status}" Style="{StaticResource Meta}" Margin="0,2,0,0" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Findings status" />
    <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2,0,0,0" Padding="8,2,0,2" Margin="0,6,0,0" Visibility="{Binding HasSnapshotNote, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Recording snapshot notice"><TextBlock Text="{Binding SnapshotNote}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /></Border>
    <TextBlock Text="{Binding DataQuality}" Style="{StaticResource Meta}" Typography.NumeralAlignment="Tabular" Margin="0,4,0,0" Visibility="{Binding HasDataQuality, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Data coverage summary" />
    <!-- The filters are secondary: small, on one line, below the summary. -->
    <WrapPanel Margin="0,6,0,0" Visibility="{Binding HasObservations, Converter={StaticResource BoolToVisibility}}">
     <StackPanel Orientation="Horizontal" Margin="0,0,16,0"><TextBlock Text="Severity" Style="{StaticResource Meta}" VerticalAlignment="Center" Margin="0,0,6,4" />
      <ListBox Style="{StaticResource Segmented}" FontSize="{StaticResource MetaFontSize}" ItemsSource="{Binding SeverityFilters}" SelectedItem="{Binding SelectedSeverity}" DisplayMemberPath="Label" AutomationProperties.Name="Severity filter" /></StackPanel>
     <StackPanel Orientation="Horizontal"><TextBlock Text="Area" Style="{StaticResource Meta}" VerticalAlignment="Center" Margin="0,0,6,4" />
      <ListBox Style="{StaticResource Segmented}" FontSize="{StaticResource MetaFontSize}" ItemsSource="{Binding DomainFilters}" SelectedItem="{Binding SelectedDomain}" DisplayMemberPath="Label" AutomationProperties.Name="Area filter" /></StackPanel>
    </WrapPanel>
    <TextBlock Text="{Binding FilterNote}" Style="{StaticResource HideWhenEmpty}" />
    <TextBlock Text="{Binding EmptyNote}" Style="{StaticResource HideWhenEmptyReading}" Margin="0,6,0,0" />

    <!-- The list on the left, what the selection means on the right; they stack below 1000 DIPs. -->
    <ui:AdaptiveColumnsPanel MinimumColumnWidth="500" MaximumColumns="2" Margin="0,6,0,0" AutomationProperties.Name="Findings and selected finding">
     <ListBox x:Name="FindingsList" ItemsSource="{Binding FindingRows}" SelectedItem="{Binding SelectedRow}" Style="{StaticResource TableList}" ItemContainerStyle="{StaticResource TableRow}" Margin="0,0,12,0" MaxHeight="{x:Static ui:HistoryLayout.FindingsListMaxHeight}" Visibility="{Binding HasVisibleObservations, Converter={StaticResource BoolToVisibility}}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Item" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Findings: select one to show its interval in the charts; a group opens with Enter, Right arrow and closes with Left arrow">
      <ListBox.Template><ControlTemplate TargetType="ListBox"><Border Background="{TemplateBinding Background}"><ScrollViewer x:Name="FindingsScroll" Focusable="False" CanContentScroll="True" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" ui:WheelChaining.Enabled="True"><ItemsPresenter /></ScrollViewer></Border></ControlTemplate></ListBox.Template>
      <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemTemplate><DataTemplate><ContentControl Content="{Binding}" Style="{StaticResource FindingRowSwitch}" AutomationProperties.Name="{Binding AutomationName}" /></DataTemplate></ListBox.ItemTemplate>
     </ListBox>

     <!-- What the selection is: nothing yet, a group of occurrences, or one observation with its measured values and evidence. -->
     <Grid>
      <TextBlock Text="Select a finding in the list or on the timeline to see what was measured and to show it in the charts." Style="{StaticResource WhenNothingSelected}" Margin="12,6,0,0" />
      <StackPanel Margin="12,0,0,0" Visibility="{Binding HasSelectedGroup, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Selected group of findings"><StackPanel DataContext="{Binding SelectedGroup}">
       <StackPanel Orientation="Horizontal"><Path Style="{StaticResource SeverityIcon}" Tag="{Binding SeverityTag}" Margin="0,0,8,0" /><TextBlock FontWeight="SemiBold" FontSize="{StaticResource StateFontSize}" TextWrapping="Wrap"><Run Text="{Binding Title, Mode=OneWay}" /></TextBlock></StackPanel>
       <TextBlock Style="{StaticResource Meta}" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0"><Run Text="{Binding CountText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Domain, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Time, Mode=OneWay}" /></TextBlock>
       <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="{Binding KeyValue}" FontSize="{StaticResource MetricFontSize}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" /><TextBlock Margin="8,0,0,3" VerticalAlignment="Bottom" Style="{StaticResource Meta}"><Run Text="{Binding KeyLabel, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding KeyMetric, Mode=OneWay}" /></TextBlock></StackPanel>
       <TextBlock Text="{Binding TotalText}" Style="{StaticResource Reading}" Typography.NumeralAlignment="Tabular" Margin="0,4,0,0" />
       <TextBlock Text="Overlapping occurrences count once. The charts show the span of all of them; open the group and choose an occurrence for its own interval and evidence." Style="{StaticResource Meta}" Margin="0,4,0,0" />
      </StackPanel>
       <WrapPanel Margin="0,6,0,0"><Button Content="Open or close the occurrences" Command="{Binding ToggleSelectedGroupCommand}" Style="{StaticResource CompactButton}" AutomationProperties.Name="Open or close the occurrences of this group" /></WrapPanel>
      </StackPanel>
      <StackPanel Margin="12,0,0,0" Visibility="{Binding HasSelectedObservation, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Selected finding evidence">
       <StackPanel Orientation="Horizontal"><Path Style="{StaticResource SeverityIcon}" Tag="{Binding SelectedObservation.SeverityTag}" Margin="0,0,8,0" /><TextBlock FontWeight="SemiBold" FontSize="{StaticResource StateFontSize}" TextWrapping="Wrap"><Run Text="{Binding SelectedObservation.Title, Mode=OneWay}" /></TextBlock></StackPanel>
       <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="{Binding SelectedObservation.KeyValue}" FontSize="{StaticResource MetricFontSize}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" /><TextBlock Margin="8,0,0,3" VerticalAlignment="Bottom" Style="{StaticResource Meta}"><Run Text="{Binding SelectedObservation.KeyLabel, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding SelectedObservation.KeyMetric, Mode=OneWay}" /></TextBlock></StackPanel>
       <TextBlock Style="{StaticResource Meta}" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0"><Run Text="{Binding SelectedObservation.Domain, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SelectedObservation.Time, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SelectedObservation.Duration, Mode=OneWay}" /></TextBlock>
       <TextBlock Text="{Binding SelectedObservation.Detail.Explanation}" Style="{StaticResource Reading}" Margin="0,8,0,0" />
       <TextBlock Text="{Binding SelectedObservation.Detail.KeyValues}" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.Name="Key measured values" />
       <TextBlock Text="{Binding SelectedObservation.Detail.Utc}" Style="{StaticResource Meta}" Typography.NumeralAlignment="Tabular" />
       <TextBlock Text="{Binding SelectedObservation.Detail.Ending}" Style="{StaticResource Meta}" />
       <WrapPanel Margin="0,6,0,0"><Button Content="Show in charts" Command="{Binding ShowInChartsCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" AutomationProperties.Name="Show in charts" ToolTip="Scroll to the chart that carries this evidence" /></WrapPanel>
     <Expander Header="Measurement evidence" Margin="0,6,0,0" AutomationProperties.Name="Measurement evidence">
      <StackPanel Margin="0,4,0,0">
       <ItemsControl ItemsSource="{Binding SelectedObservation.Detail.Metrics}" Focusable="False" AutomationProperties.Name="Measured metrics"><ItemsControl.ItemTemplate><DataTemplate>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,4">
         <StackPanel AutomationProperties.Name="{Binding Summary}">
          <TextBlock Style="{StaticResource Reading}"><Run Text="{Binding Metric, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Unit, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" /><Run Text="  ·  " Foreground="{DynamicResource MutedBrush}" /><Run Text="{Binding Role, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" /></TextBlock>
          <TextBlock Style="{StaticResource Reading}" Typography.NumeralAlignment="Tabular"><Run Text="min " Foreground="{DynamicResource MutedBrush}" /><Run Text="{Binding Minimum, Mode=OneWay}" /><Run Text="   P50 " Foreground="{DynamicResource MutedBrush}" /><Run Text="{Binding P50, Mode=OneWay}" /><Run Text="   P95 " Foreground="{DynamicResource MutedBrush}" /><Run Text="{Binding P95, Mode=OneWay}" /><Run Text="   max " Foreground="{DynamicResource MutedBrush}" /><Run Text="{Binding Maximum, Mode=OneWay}" /></TextBlock>
          <TextBlock Style="{StaticResource Meta}" Typography.NumeralAlignment="Tabular"><Run Text="Worst recorded at " /><Run Text="{Binding WorstAt, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ValidSamples, Mode=OneWay}" /><Run Text=" valid samples" /></TextBlock>
         </StackPanel>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <TextBlock Text="Threshold and baseline" Style="{StaticResource SubLabel}" />
       <ItemsControl ItemsSource="{Binding SelectedObservation.Detail.Threshold}" Focusable="False"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Reading}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
     </Expander>
     <Expander Header="{Binding SelectedObservation.Detail.LimitationsHeader}" Margin="0,2,0,0" Visibility="{Binding SelectedObservation.Detail.HasLimitations, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Recording limitations and nearby events">
      <StackPanel Margin="0,4,0,0">
       <ItemsControl ItemsSource="{Binding SelectedObservation.Detail.Limitations}" Focusable="False"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Reading}" Margin="0,0,0,4" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <ItemsControl ItemsSource="{Binding SelectedObservation.Detail.Events}" Focusable="False"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Meta}" Typography.NumeralAlignment="Tabular" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
     </Expander>

      </StackPanel>
     </Grid>
    </ui:AdaptiveColumnsPanel>

    <!-- Correlations: timing only. Performance correlations first; availability-only ones are kept, but out of the way. -->
    <TextBlock Text="Performance correlations" Style="{StaticResource SubLabel}" Margin="0,12,0,4" Visibility="{Binding HasPerformanceCorrelations, Converter={StaticResource BoolToVisibility}}" />
    <ListBox x:Name="CorrelationList" ItemsSource="{Binding PerformanceCorrelations}" SelectedItem="{Binding SelectedCorrelation}" Style="{StaticResource TableList}" ItemContainerStyle="{StaticResource TableRow}" MaxHeight="{x:Static ui:HistoryLayout.CorrelationListMaxHeight}" Visibility="{Binding HasPerformanceCorrelations, Converter={StaticResource BoolToVisibility}}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Performance correlations: timing relationships, not causes">
     <ListBox.Template><ControlTemplate TargetType="ListBox"><Border Background="{TemplateBinding Background}"><ScrollViewer Focusable="False" CanContentScroll="True" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" ui:WheelChaining.Enabled="True"><ItemsPresenter /></ScrollViewer></Border></ControlTemplate></ListBox.Template>
     <ListBox.ItemTemplate><DataTemplate><StackPanel AutomationProperties.Name="{Binding AutomationName}">
      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{StaticResource ReadingFontSize}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Summary}" Style="{StaticResource Reading}" />
      <TextBlock Style="{StaticResource Meta}" Typography.NumeralAlignment="Tabular"><Run Text="{Binding Timing, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Time, Mode=OneWay}" /></TextBlock>
     </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Expander Header="{Binding ContextHeader}" Margin="0,8,0,0" Visibility="{Binding HasContextCorrelations, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Recording and availability context">
     <StackPanel Margin="0,4,0,0">
      <TextBlock Text="Findings that lie next to missing data, a disconnect or a session change. They describe the recording, not a cause." Style="{StaticResource Meta}" />
      <ListBox x:Name="ContextList" ItemsSource="{Binding ContextCorrelations}" SelectedItem="{Binding SelectedContextCorrelation}" Style="{StaticResource TableList}" ItemContainerStyle="{StaticResource TableRow}" MaxHeight="{x:Static ui:HistoryLayout.CorrelationListMaxHeight}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Availability context">
       <ListBox.Template><ControlTemplate TargetType="ListBox"><Border Background="{TemplateBinding Background}"><ScrollViewer Focusable="False" CanContentScroll="True" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" ui:WheelChaining.Enabled="True"><ItemsPresenter /></ScrollViewer></Border></ControlTemplate></ListBox.Template>
       <ListBox.ItemTemplate><DataTemplate><StackPanel AutomationProperties.Name="{Binding AutomationName}">
        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource Meta}" Typography.NumeralAlignment="Tabular"><Run Text="{Binding Timing, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Time, Mode=OneWay}" /></TextBlock>
       </StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </StackPanel>
    </Expander>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0" Visibility="{Binding HasSelectedCorrelation, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Selected correlation"><StackPanel>
     <TextBlock Text="{Binding ActiveCorrelation.Title}" FontWeight="SemiBold" FontSize="{StaticResource StateFontSize}" TextWrapping="Wrap" />
     <TextBlock Text="{Binding ActiveCorrelation.Timing}" Style="{StaticResource ValueText}" TextWrapping="Wrap" Margin="0,4,0,0" />
     <TextBlock Text="{Binding ActiveCorrelation.Explanation}" Style="{StaticResource Reading}" Margin="0,4,0,0" />
     <ItemsControl ItemsSource="{Binding ActiveCorrelation.Links}" Focusable="False" Margin="0,4,0,0" AutomationProperties.Name="How the components are linked"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Meta}" Typography.NumeralAlignment="Tabular" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="Components (select one to inspect it)" Style="{StaticResource SubLabel}" />
     <ListBox ItemsSource="{Binding ActiveCorrelation.Components}" SelectedItem="{Binding SelectedComponent}" Style="{StaticResource TableList}" ItemContainerStyle="{StaticResource TableRow}" AutomationProperties.Name="Component observations">
      <ListBox.ItemTemplate><DataTemplate><Grid AutomationProperties.Name="{Binding AutomationName}">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
       <Path Style="{StaticResource SeverityIcon}" Tag="{Binding SeverityTag}" VerticalAlignment="Top" Margin="0,2,8,0" />
       <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Measurement}" Style="{StaticResource Reading}" /><TextBlock Style="{StaticResource Meta}" Typography.NumeralAlignment="Tabular"><Run Text="{Binding Time, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Duration, Mode=OneWay}" /></TextBlock></StackPanel>
      </Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <ItemsControl ItemsSource="{Binding ActiveCorrelation.Limitations}" Focusable="False" Margin="0,4,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Meta}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <WrapPanel Margin="0,6,0,0"><Button Content="Show in charts" Command="{Binding ShowInChartsCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Show correlation in charts" /></WrapPanel>
    </StackPanel></Border>

    <!-- What could not be said, by kind: no anomaly, no usable measurement, not applicable, insufficient evidence, incomplete recording. -->
    <Expander Header="{Binding QualityHeader}" Margin="0,8,0,0" Visibility="{Binding HasQualityGroups, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Data quality and evaluation details">
     <ItemsControl ItemsSource="{Binding QualityGroups}" Focusable="False" Margin="0,4,0,0"><ItemsControl.ItemTemplate><DataTemplate>
      <StackPanel Margin="0,0,0,6" AutomationProperties.Name="{Binding HeadingWithCount}">
       <TextBlock Text="{Binding HeadingWithCount}" Style="{StaticResource SubLabel}" Margin="0,6,0,0" />
       <TextBlock Text="{Binding Note}" Style="{StaticResource Meta}" />
       <ItemsControl ItemsSource="{Binding Lines}" Focusable="False"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Reading}" Margin="0,2,0,0" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </Expander>
   </StackPanel></Border>
   <Border Style="{StaticResource Panel}" AutomationProperties.Name="Time range"><StackPanel>
    <WrapPanel>
     <StackPanel Margin="0,0,12,6"><TextBlock Text="Range" Style="{StaticResource Meta}" /><ComboBox Width="170" ItemsSource="{Binding Monitor.History.RangePresets}" SelectedItem="{Binding Monitor.History.SelectedPreset}" DisplayMemberPath="Label" AutomationProperties.Name="Range preset" /></StackPanel>
     <StackPanel Margin="0,0,12,6"><TextBlock Text="Zoom" Style="{StaticResource Meta}" /><WrapPanel><Button Content="Zoom out" Command="{Binding Monitor.History.ZoomOutCommand}" Margin="0,0,6,0" ToolTip="Show twice the time (Ctrl + mouse wheel, or the minus key on the charts)" /><Button Content="Zoom in" Command="{Binding Monitor.History.ZoomInCommand}" Margin="0,0,6,0" ToolTip="Show half the time (Ctrl + mouse wheel, or the plus key on the charts)" /><Button Content="Reset zoom" Command="{Binding Monitor.History.ResetZoomCommand}" ToolTip="Show the entire session (Home on the charts)" /></WrapPanel></StackPanel>
     <StackPanel Margin="0,0,12,6"><TextBlock Text="Incidents" Style="{StaticResource Meta}" /><WrapPanel><Button Content="◀ Previous incident" Command="{Binding Monitor.History.PreviousIncidentCommand}" Margin="0,0,6,0" AutomationProperties.Name="Previous incident" ToolTip="Page Up on the charts" /><Button Content="Next incident ▶" Command="{Binding Monitor.History.NextIncidentCommand}" AutomationProperties.Name="Next incident" ToolTip="Page Down on the charts" /></WrapPanel></StackPanel>
     <StackPanel Margin="0,0,12,6"><TextBlock Text="Context around an incident" Style="{StaticResource Meta}" /><ComboBox Width="110" ItemsSource="{Binding Monitor.History.ContextChoices}" SelectedItem="{Binding Monitor.History.SelectedContext}" DisplayMemberPath="Label" AutomationProperties.Name="Context around an incident" /></StackPanel>
    </WrapPanel>
    <WrapPanel>
     <StackPanel Margin="0,0,8,6"><TextBlock Text="From (local time)" Style="{StaticResource Meta}" /><TextBox Width="170" Text="{Binding Monitor.History.CustomFrom, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Range start, local time" /></StackPanel>
     <StackPanel Margin="0,0,8,6"><TextBlock Text="To (local time)" Style="{StaticResource Meta}" /><TextBox Width="170" Text="{Binding Monitor.History.CustomTo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Range end, local time" /></StackPanel>
     <Button Content="Apply range" Command="{Binding Monitor.History.ApplyCustomRangeCommand}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
    </WrapPanel>
    <TextBlock Text="{Binding Monitor.History.RangeText}" Style="{StaticResource Reading}" Typography.NumeralAlignment="Tabular" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Visible range" />
    <TextBlock Text="{Binding Monitor.History.RangeMessage}" Foreground="{DynamicResource CriticalBrush}" TextWrapping="Wrap" />
    <TextBlock Text="Drag across the strip or the charts to select a range. Ctrl + mouse wheel zooms. With a chart or the strip focused: arrow keys move, + and − zoom, Home shows the entire session, Page Up and Page Down step through incidents." Style="{StaticResource Meta}" Margin="0,4,0,6" />
    <ui:HistoryTimelineStrip x:Name="Strip" SessionStart="{Binding Monitor.History.SessionStart, Mode=OneWay}" SessionEnd="{Binding Monitor.History.SessionEnd, Mode=OneWay}" ViewStart="{Binding Monitor.History.ViewStart, Mode=OneWay}" ViewEnd="{Binding Monitor.History.ViewEnd, Mode=OneWay}" Markers="{Binding Monitor.History.Markers, Mode=OneWay}" Gaps="{Binding Monitor.History.Gaps, Mode=OneWay}" SelectedAt="{Binding Monitor.History.SelectedIncident.Incident.At, Mode=OneWay, FallbackValue={x:Null}}" HighlightStart="{Binding Monitor.History.Findings.HighlightStart, Mode=OneWay}" HighlightEnd="{Binding Monitor.History.Findings.HighlightEnd, Mode=OneWay}" PeakAt="{Binding Monitor.History.Findings.PeakAt, Mode=OneWay}" Zone="{Binding Monitor.History.Zone, Mode=OneWay}" AutomationProperties.Name="Session timeline: events, gaps and the visible range" ToolTip="The whole session. Each kind of event has its own shape (legend below). Shaded stretches have no samples. The framed part is what the charts show." />
    <ItemsControl ItemsSource="{x:Static ui:HistoryEventKinds.IconTags}" Focusable="False" Margin="0,4,0,0" AutomationProperties.Name="Event shapes"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,0,14,0"><Path Style="{StaticResource EventIcon}" Tag="{Binding}" Margin="0,0,4,0" /><TextBlock Text="{Binding}" Style="{StaticResource Meta}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel></Border>

   <Border Style="{StaticResource ChartSurface}" AutomationProperties.Name="Historical charts"><StackPanel>
    <TextBlock Text="Measurements in the visible range" FontWeight="SemiBold" />
    <TextBlock Text="{Binding Monitor.History.HoverText}" Style="{StaticResource Meta}" Typography.NumeralAlignment="Tabular" MinHeight="16" AutomationProperties.LiveSetting="Off" AutomationProperties.Name="Time under the pointer" />
    <Grid>
     <ItemsControl x:Name="ChartList" ItemsSource="{Binding Monitor.History.Charts}" Focusable="False" AutomationProperties.Name="Chart list">
      <ItemsControl.ItemTemplate><DataTemplate>
       <StackPanel>
        <TextBlock Text="{Binding Group}" Style="{StaticResource SectionLabel}" Visibility="{Binding ShowGroup, Converter={StaticResource BoolToVisibility}}" />
        <Border BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,6,0,0">
         <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="Background" Value="Transparent" />
          <Style.Triggers><DataTrigger Binding="{Binding IsPrimary}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style>
         <StackPanel>
          <TextBlock Text="{Binding EmphasisLabel}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Style="{StaticResource Meta}" Visibility="{Binding IsEmphasized, Converter={StaticResource BoolToVisibility}}" />
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
           <TextBlock TextWrapping="Wrap" FontSize="{StaticResource ReadingFontSize}"><Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " Foreground="{DynamicResource MutedBrush}" /><Run Text="{Binding Unit, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" /></TextBlock>
           <TextBlock Grid.Column="1" Text="{Binding Readout}" Style="{StaticResource Meta}" TextAlignment="Right" Typography.NumeralAlignment="Tabular" Margin="8,0,0,0" />
          </Grid>
          <TextBlock Text="{Binding Stats}" Style="{StaticResource Meta}" Typography.NumeralAlignment="Tabular" />
          <TextBlock Text="{Binding UnitNote}" Style="{StaticResource Meta}" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding HasUnitNote, Converter={StaticResource BoolToVisibility}}" />
          <Grid Height="120" Margin="0,4,0,0">
           <lvc:CartesianChart ui:LiveChart.Data="{Binding Data}" AnimationsSpeed="0:0:0" DrawMargin="{x:Static ui:HistoryLayout.PlotMargin}" TooltipPosition="Hidden" Background="{DynamicResource ChartBackgroundBrush}" ui:ChartTheme.Text="{DynamicResource MutedBrush}" ui:ChartTheme.Surface="{DynamicResource SurfaceBrush}" ui:ChartTheme.Grid="{DynamicResource ChartGridBrush}" ui:ChartTheme.Line="{DynamicResource AccentBrush}" ui:ChartTheme.Warning="{DynamicResource WarningBrush}" ui:ChartTheme.Critical="{DynamicResource CriticalBrush}" AutomationProperties.Name="{Binding AutomationName}" />
           <TextBlock Text="No valid values in this range" Style="{StaticResource Reading}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowNoData, Converter={StaticResource BoolToVisibility}}" />
          </Grid>
         </StackPanel>
        </Border>
       </StackPanel>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <ui:HistoryChartOverlay x:Name="Overlay" PlotLeft="{x:Static ui:HistoryLayout.PlotLeft}" PlotRight="{x:Static ui:HistoryLayout.PlotRight}" ViewStart="{Binding Monitor.History.ViewStart, Mode=OneWay}" ViewEnd="{Binding Monitor.History.ViewEnd, Mode=OneWay}" Markers="{Binding Monitor.History.Markers, Mode=OneWay}" Gaps="{Binding Monitor.History.Gaps, Mode=OneWay}" SelectedAt="{Binding Monitor.History.SelectedIncident.Incident.At, Mode=OneWay, FallbackValue={x:Null}}" HighlightStart="{Binding Monitor.History.Findings.HighlightStart, Mode=OneWay}" HighlightEnd="{Binding Monitor.History.Findings.HighlightEnd, Mode=OneWay}" PeakAt="{Binding Monitor.History.Findings.PeakAt, Mode=OneWay}" Zone="{Binding Monitor.History.Zone, Mode=OneWay}" AutomationProperties.Name="Charts time cursor: move the pointer to read values, drag to select a range" />
    </Grid>
   </StackPanel></Border>

   <Border Style="{StaticResource Panel}" AutomationProperties.Name="Incident timeline"><StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="Incident timeline" FontWeight="SemiBold" /><TextBlock Text="{Binding Monitor.History.EventsHeading}" Style="{StaticResource Meta}" /></StackPanel>
     <ComboBox Grid.Column="1" Width="200" ItemsSource="{Binding Monitor.History.Filters}" SelectedItem="{Binding Monitor.History.SelectedFilter}" DisplayMemberPath="Label" AutomationProperties.Name="Event filter" />
    </Grid>
    <ui:AdaptiveColumnsPanel MinimumColumnWidth="430" MaximumColumns="2" Margin="0,8,0,0" AutomationProperties.Name="Events and selected incident">
     <!-- Virtualized: the page measures this list with unlimited height, so it has its own bounded viewport (MaxHeight) and scroll viewer; only the rows in view
          (plus a few) get containers, which are recycled while scrolling. Every entry stays in the collection. The wheel passes to the page at either end. -->
     <ListBox x:Name="EventList" ItemsSource="{Binding Monitor.History.Events}" SelectedItem="{Binding Monitor.History.SelectedEvent}" Style="{StaticResource TableList}" ItemContainerStyle="{StaticResource TableRow}" MaxHeight="{x:Static ui:HistoryLayout.EventListMaxHeight}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Item" VirtualizingPanel.CacheLength="1,1" VirtualizingPanel.CacheLengthUnit="Item" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Timeline events">
      <ListBox.Template><ControlTemplate TargetType="ListBox"><Border Background="{TemplateBinding Background}"><ScrollViewer x:Name="EventScroll" Focusable="False" CanContentScroll="True" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" ui:WheelChaining.Enabled="True"><ItemsPresenter /></ScrollViewer></Border></ControlTemplate></ListBox.Template>
      <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemTemplate><DataTemplate>
       <Grid AutomationProperties.Name="{Binding AutomationName}"><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Path Style="{StaticResource EventIcon}" Tag="{Binding IconTag}" />
        <StackPanel Grid.Column="1" Margin="0,0,12,0" MinWidth="104"><TextBlock Text="{Binding Time}" Typography.NumeralAlignment="Tabular" FontSize="{StaticResource ReadingFontSize}" /><TextBlock Text="{Binding KindLabel}" Style="{StaticResource Meta}" /></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="{Binding Title}" Style="{StaticResource Reading}" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" Style="{StaticResource Meta}" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" /><TextBlock Text="{Binding Annotation}" Style="{StaticResource Reading}" Visibility="{Binding HasAnnotation, Converter={StaticResource BoolToVisibility}}" /></StackPanel>
       </Grid>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel Visibility="{Binding Monitor.History.HasSelectedIncident, Converter={StaticResource BoolToVisibility}}" Margin="12,0,0,0">
     <StackPanel DataContext="{Binding Monitor.History.SelectedIncident}" AutomationProperties.Name="Selected incident">
      <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="What the recording shows around this marker" Style="{StaticResource SubLabel}" />
      <TextBlock Text="{Binding Summary}" Style="{StaticResource Reading}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Summary of the recording around the incident" />
      <ItemsControl ItemsSource="{Binding Changes}" Focusable="False" Margin="0,6,0,0" AutomationProperties.Name="Observed changes"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Style="{StaticResource Reading}" Margin="0,2,0,0"><Run Text="• " /><Run Text="{Binding Mode=OneWay}" /></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <ItemsControl ItemsSource="{Binding Missing}" Focusable="False" Margin="0,6,0,0" AutomationProperties.Name="Missing measurements"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Style="{StaticResource Meta}"><Run Text="Missing: " /><Run Text="{Binding Mode=OneWay}" /></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="Recorded diagnostic state" Style="{StaticResource SubLabel}" />
      <TextBlock Text="{Binding RecordedState}" Style="{StaticResource Reading}" />
      <TextBlock Text="Administrator annotation" Style="{StaticResource SubLabel}" />
      <ComboBox ItemsSource="{x:Static vmtypes:HistoryIncidentViewModel.Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="Label" Width="240" HorizontalAlignment="Left" AutomationProperties.Name="Incident category" />
      <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="64" Margin="0,6,0,0" AutomationProperties.Name="Incident description" />
      <WrapPanel Margin="0,6,0,0"><Button Content="Save annotation" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" /><TextBlock Text="{Binding DescriptionCount}" Style="{StaticResource Meta}" VerticalAlignment="Center" Margin="0,0,10,0" /><TextBlock Text="{Binding SaveMessage}" Style="{StaticResource Meta}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" /></WrapPanel>
      <TextBlock Text="Saved beside the recording in a small file; the recording itself is never rewritten." Style="{StaticResource Meta}" />
      <Expander Header="Recorded evidence: every metric before and after the marker" IsExpanded="{Binding IsEvidenceExpanded}" Margin="0,10,0,0" AutomationProperties.Name="Recorded evidence">
       <ItemsControl ItemsSource="{Binding Evidence}" Focusable="False"><ItemsControl.ItemTemplate><DataTemplate>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Style="{StaticResource Reading}"><Run Text="{Binding Metric, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Sample, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" /></TextBlock><TextBlock Text="{Binding Status}" Style="{StaticResource Meta}" /></StackPanel>
         <TextBlock Grid.Column="1" TextAlignment="Right" Typography.NumeralAlignment="Tabular" Margin="8,0,0,0" Style="{StaticResource Reading}"><Run Text="{Binding Value, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding Unit, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" /></TextBlock>
        </Grid></Border>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </Expander>
     </StackPanel>
     </StackPanel>
    </ui:AdaptiveColumnsPanel>
   </StackPanel></Border>
  </StackPanel>
 </StackPanel>
</UserControl>
