<UserControl x:Class="EucLens.App.Views.AdvancedView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <TextBlock Text="Advanced metrics" Style="{StaticResource Heading}" />
  <TextBlock Text="Raw collector output: value, unit, scope, availability, source and sample time. Machine-wide values include every session on this machine; session values describe this Windows session only." Style="{StaticResource Muted}" Margin="0,0,0,12" />
  <Border Style="{StaticResource Panel}"><StackPanel>
   <WrapPanel><StackPanel Margin="0,0,0,8"><TextBlock Text="Category" Style="{StaticResource Muted}" /><ComboBox Width="200" ItemsSource="{Binding Monitor.AdvancedCategories}" SelectedItem="{Binding Monitor.SelectedAdvancedCategory}" DisplayMemberPath="Label" AutomationProperties.Name="Metric category" /></StackPanel><StackPanel Margin="0,0,0,8"><TextBlock Text="Search" Style="{StaticResource Muted}" /><TextBox Width="260" Text="{Binding Monitor.AdvancedSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search metrics by name, identifier, value or source" /></StackPanel></WrapPanel>
   <TextBlock Text="{Binding Monitor.AdvancedStatus}" Style="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite" />
  </StackPanel></Border>
  <Border Style="{StaticResource Panel}"><StackPanel>
   <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,4">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="{StaticResource AdvancedValueWidth}" /><ColumnDefinition Width="{StaticResource AdvancedStatusWidth}" /><ColumnDefinition Width="{StaticResource AdvancedTimeWidth}" /></Grid.ColumnDefinitions>
     <TextBlock Text="Metric · category · scope · source" Style="{StaticResource Muted}" /><TextBlock Grid.Column="1" Text="Value" Style="{StaticResource Muted}" TextAlignment="Right" Margin="0,0,12,0" /><TextBlock Grid.Column="2" Text="Status" Style="{StaticResource Muted}" /><TextBlock Grid.Column="3" Text="Sample time" Style="{StaticResource Muted}" />
    </Grid>
   </Border>
   <ItemsControl ItemsSource="{Binding Monitor.AdvancedRows}" AutomationProperties.Name="Advanced metrics"><ItemsControl.ItemTemplate><DataTemplate>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,4">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="{StaticResource AdvancedValueWidth}" /><ColumnDefinition Width="{StaticResource AdvancedStatusWidth}" /><ColumnDefinition Width="{StaticResource AdvancedTimeWidth}" /></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /><TextBlock Style="{StaticResource Muted}" FontSize="11"><Run Text="{Binding Category, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Scope, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Id, Mode=OneWay}" /><LineBreak /><Run Text="{Binding Source, Mode=OneWay}" /></TextBlock></StackPanel>
      <TextBlock Grid.Column="1" TextWrapping="Wrap" TextAlignment="Right" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Margin="0,0,12,0"><Run Text="{Binding Value, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Unit, Mode=OneWay}" FontWeight="Normal" /></TextBlock>
      <TextBlock Grid.Column="2" Text="{Binding Status}" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Available"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Stale"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Foreground" Value="{DynamicResource CriticalBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <TextBlock Grid.Column="3" Text="{Binding Timestamp}" Style="{StaticResource Muted}" Typography.NumeralAlignment="Tabular" />
     </Grid>
    </Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></Border>
 </StackPanel>
</UserControl>
