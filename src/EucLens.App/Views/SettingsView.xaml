<UserControl x:Class="EucLens.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:EucLens.App.Presentation" xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
 <StackPanel>
  <TextBlock Text="Settings" Style="{StaticResource Heading}" />
  <TextBlock Text="Local preferences. No account, no telemetry and no network connection needed. The only network use is the update check you start yourself on the About page." Style="{StaticResource Muted}" Margin="0,0,0,12" />
  <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Appearance" FontWeight="SemiBold" /><CheckBox Content="Use dark theme" IsChecked="{Binding Monitor.IsDark}" /><TextBlock Text="Theme changes apply immediately." Style="{StaticResource Muted}" /><Button Content="Save preferences" Command="{Binding Monitor.SavePreferencesCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,8" /><TextBlock Text="Saves the theme under %LOCALAPPDATA%\EucLens\preferences.json." Style="{StaticResource Muted}" /></StackPanel></Border>
  <Border Style="{StaticResource Panel}" AutomationProperties.Name="Data source"><StackPanel><TextBlock Text="Data source" FontWeight="SemiBold" Margin="0,0,0,8" /><WrapPanel AutomationProperties.Name="Session data source"><StackPanel Margin="0,0,24,8" ToolTip="{Binding Monitor.ProtocolDetail}"><TextBlock Text="Detected protocol" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Monitor.ProtocolDisplay}" FontWeight="SemiBold" Margin="0,4,0,0" AutomationProperties.Name="Detected protocol" /></StackPanel><StackPanel Margin="0,0,0,8"><TextBlock Text="Data availability" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Monitor.DataAvailability}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.Name="Data availability" /></StackPanel></WrapPanel><TextBlock Text="EUC Lens measures the session it runs in: Horizon Blast counters when this Windows session has them, and protocol-independent Windows metrics (CPU, memory, disk, GPU) in every session. Missing measurements display N/A. Frame-rate rules use the measured screen activity (Blast dirty frames); there is nothing to select." Style="{StaticResource Muted}" TextWrapping="Wrap" /></StackPanel></Border>
  <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Diagnostic thresholds" FontWeight="SemiBold" Margin="0,0,0,8" /><TextBlock Text="{Binding Monitor.ThresholdStatus}" Style="{StaticResource Muted}" Margin="0,0,0,8" /><ItemsControl ItemsSource="{Binding Monitor.ThresholdCards}" Style="{StaticResource MetricRows}" /><WrapPanel Margin="0,8,0,8"><Button Content="Restore defaults" Command="{Binding Monitor.RestoreThresholdDefaultsCommand}" AutomationProperties.Name="Restore default diagnostic thresholds" /><Button Content="Reload from file" Command="{Binding Monitor.ReloadThresholdsCommand}" AutomationProperties.Name="Reload diagnostic thresholds" /></WrapPanel><TextBlock Text="Values are initial tunable defaults, not vendor or industry standards. Restore defaults writes all values to the file below; edit it (units are part of each property name) and select Reload. Invalid or contradictory values are rejected and the defaults stay in use." Style="{StaticResource Muted}" /><TextBlock Text="{Binding Monitor.ThresholdPath}" Style="{StaticResource Muted}" Margin="0,4,0,0" /></StackPanel></Border>
  <Border Style="{StaticResource Panel}" AutomationProperties.Name="Background monitoring"><StackPanel>
   <TextBlock Text="Background monitoring" FontWeight="SemiBold" Margin="0,0,0,4" />
   <TextBlock Text="{Binding Monitor.Background.TrayExplanation}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
   <CheckBox Content="Minimize to system tray" IsChecked="{Binding Monitor.Background.MinimizeToTray}" ToolTip="Minimizing hides the window and the taskbar button. Monitoring and any recording continue." />
   <CheckBox Content="Close button minimizes to tray" IsChecked="{Binding Monitor.Background.CloseToTray}" ToolTip="The close button hides the window. Use Exit in the tray menu to end EUC Lens." />
   <CheckBox Content="Show notifications for confirmed problems and recording failures" IsChecked="{Binding Monitor.Background.Notifications}" ToolTip="Only conclusions of the diagnostic engine and storage failures, at most one per problem every 30 minutes. No names, addresses or measurements." />
   <CheckBox Content="Start monitoring when EUC Lens starts" IsChecked="{Binding Monitor.Background.MonitorOnStart}" />
   <CheckBox Content="Start a recording when monitoring starts (opt-in)" IsChecked="{Binding Monitor.Background.RecordOnStart}" ToolTip="Off by default. EUC Lens never starts with Windows." />
   <TextBlock Text="Recordings folder" Style="{StaticResource Muted}" Margin="0,12,0,2" />
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <TextBox Text="{Binding Monitor.Background.RecordingDirectory, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Recordings folder (empty uses the default)" />
    <Button Grid.Column="1" Content="Browse…" Command="{Binding Monitor.Background.BrowseFolderCommand}" Margin="8,0,0,0" /><Button Grid.Column="2" Content="Default" Command="{Binding Monitor.Background.UseDefaultFolderCommand}" Margin="8,0,0,0" />
   </Grid>
   <TextBlock Text="{Binding Monitor.Background.EffectiveDirectoryText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
   <TextBlock Text="{Binding Monitor.Background.DurabilityNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
   <WrapPanel Margin="0,12,0,0">
    <StackPanel Margin="0,0,16,0"><TextBlock Text="Storage quota (MiB)" Style="{StaticResource Muted}" /><TextBox Width="110" Text="{Binding Monitor.Background.RetentionQuotaMiB, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Storage quota in MiB" /></StackPanel>
    <StackPanel><TextBlock Text="Keep recordings (days, 0 = until quota)" Style="{StaticResource Muted}" /><TextBox Width="110" Text="{Binding Monitor.Background.RetentionDays, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Retention in days" /></StackPanel>
   </WrapPanel>
   <TextBlock Text="Older EUC Lens recordings are removed first when the quota or age limit is exceeded. Only files EUC Lens wrote in this folder are ever deleted, and never the recording in progress; if one recording alone outgrows the quota it stops and says so." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,8" />
   <Button Content="Save background settings" Command="{Binding Monitor.Background.SaveCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" />
   <TextBlock Text="{Binding Monitor.Background.SettingsMessage}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
  </StackPanel></Border>
  <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Collection and storage" FontWeight="SemiBold" Margin="0,0,0,8" /><TextBlock Text="Sampling: 1 second. Live history: 120 samples. Recorder history: latest 600 samples. Recording is manual (or opt-in at start) and streams to the recordings folder above; there is no sample limit, only the storage quota. Local application logs are capped at approximately 1 MB plus one previous file." Style="{StaticResource Muted}" /></StackPanel></Border>
 </StackPanel>
</UserControl>
