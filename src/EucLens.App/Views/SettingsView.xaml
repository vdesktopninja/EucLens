<UserControl x:Class="EucLens.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:EucLens.App.Presentation" xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
 <StackPanel>
  <TextBlock Text="Settings" Style="{StaticResource Heading}" />
  <TextBlock Text="Local preferences. No account, telemetry or runtime network connection required." Style="{StaticResource Muted}" Margin="0,0,0,12" />
  <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Appearance" FontWeight="SemiBold" /><CheckBox Content="Use dark theme" IsChecked="{Binding Monitor.IsDark}" /><TextBlock Text="Theme changes apply immediately." Style="{StaticResource Muted}" /></StackPanel></Border>
  <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Monitoring defaults" FontWeight="SemiBold" Margin="0,0,0,8" /><WrapPanel><StackPanel Margin="0,0,0,8"><TextBlock Text="Data source" Style="{StaticResource Muted}" /><ComboBox Width="200" ItemsSource="{Binding Monitor.Modes}" SelectedItem="{Binding Monitor.SelectedMode}" DisplayMemberPath="Label" AutomationProperties.Name="Monitoring mode" /></StackPanel><StackPanel Margin="0,0,16,8" Visibility="{Binding Monitor.IsReal, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding Monitor.ProtocolDetail}"><TextBlock Text="Detected protocol" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Monitor.ProtocolDisplay}" FontWeight="SemiBold" Margin="0,10,0,0" AutomationProperties.Name="Detected protocol" /></StackPanel><StackPanel Margin="0,0,0,8" Visibility="{Binding Monitor.IsDemo, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Demo protocol" Style="{StaticResource Muted}" /><ComboBox Width="200" ItemsSource="{Binding Monitor.Protocols}" SelectedItem="{Binding Monitor.SelectedProtocol}" DisplayMemberPath="Label" AutomationProperties.Name="Simulated protocol" /></StackPanel><StackPanel Margin="0,0,0,8" Visibility="{Binding Monitor.IsDemo, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Demo scenario" Style="{StaticResource Muted}" /><ComboBox Width="200" ItemsSource="{Binding Monitor.Scenarios}" SelectedItem="{Binding Monitor.SelectedScenario}" DisplayMemberPath="Label" AutomationProperties.Name="Demo scenario" /></StackPanel><StackPanel Margin="0,0,0,8"><TextBlock Text="Workload" Style="{StaticResource Muted}" /><ComboBox Width="200" ItemsSource="{Binding Monitor.Workloads}" SelectedItem="{Binding Monitor.SelectedWorkload}" DisplayMemberPath="Label" AutomationProperties.Name="Workload context" /></StackPanel></WrapPanel><Button Content="Save preferences" Command="{Binding Monitor.SavePreferencesCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,4,0,8" /><TextBlock Text="Saved under %LOCALAPPDATA%\EucLens\preferences.json. Selections apply immediately. Protocol and scenario apply to Demo Mode only; real sessions use local Horizon Blast counters." Style="{StaticResource Muted}" /></StackPanel></Border>
  <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Diagnostic thresholds" FontWeight="SemiBold" Margin="0,0,0,8" /><TextBlock Text="{Binding Monitor.ThresholdStatus}" Style="{StaticResource Muted}" Margin="0,0,0,8" /><ItemsControl ItemsSource="{Binding Monitor.ThresholdCards}" Style="{StaticResource MetricRows}" /><WrapPanel Margin="0,8,0,8"><Button Content="Restore defaults" Command="{Binding Monitor.RestoreThresholdDefaultsCommand}" AutomationProperties.Name="Restore default diagnostic thresholds" /><Button Content="Reload from file" Command="{Binding Monitor.ReloadThresholdsCommand}" AutomationProperties.Name="Reload diagnostic thresholds" /></WrapPanel><TextBlock Text="Values are initial tunable defaults, not vendor or industry standards. Restore defaults writes all values to the file below; edit it (units are part of each property name) and select Reload. Invalid or contradictory values are rejected and the defaults stay in use." Style="{StaticResource Muted}" /><TextBlock Text="{Binding Monitor.ThresholdPath}" Style="{StaticResource Muted}" Margin="0,4,0,0" /></StackPanel></Border>
  <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Collection and storage" FontWeight="SemiBold" Margin="0,0,0,8" /><TextBlock Text="Sampling: 1 second. Live history: 120 samples. Recorder history: latest 600 samples. Recording limit: 86,400 samples. Recording is manual; metrics are saved only when exported. Local application logs are capped at approximately 1 MB plus one previous file." Style="{StaticResource Muted}" /></StackPanel></Border>
 </StackPanel>
</UserControl>
