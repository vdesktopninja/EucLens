<UserControl x:Class="EucLens.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel><TextBlock Text="Make it your workspace" Style="{StaticResource Heading}" /><TextBlock Text="Preferences stay on this computer. No account, telemetry or network connection is required at runtime." Style="{StaticResource Muted}" Margin="0,0,0,20" />
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold" /><CheckBox Content="Use dark theme" IsChecked="{Binding Monitor.IsDark}" /><TextBlock Text="Changes apply immediately across the workspace." Style="{StaticResource Muted}" /></StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Demo workspace defaults" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" /><WrapPanel><StackPanel><TextBlock Text="Protocol" Style="{StaticResource Muted}" /><ComboBox ItemsSource="{Binding Monitor.Protocols}" SelectedItem="{Binding Monitor.SelectedProtocol}" DisplayMemberPath="Label" AutomationProperties.Name="Preferred protocol" /></StackPanel><StackPanel><TextBlock Text="Scenario" Style="{StaticResource Muted}" /><ComboBox ItemsSource="{Binding Monitor.Scenarios}" SelectedItem="{Binding Monitor.SelectedScenario}" DisplayMemberPath="Label" AutomationProperties.Name="Preferred scenario" /></StackPanel><StackPanel><TextBlock Text="Workload" Style="{StaticResource Muted}" /><ComboBox ItemsSource="{Binding Monitor.Workloads}" SelectedItem="{Binding Monitor.SelectedWorkload}" DisplayMemberPath="Label" AutomationProperties.Name="Preferred workload" /></StackPanel></WrapPanel><Button Content="Save preferences" Command="{Binding Monitor.SavePreferencesCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,20,0,0" /><TextBlock Text="Saved under %LOCALAPPDATA%\EucLens\preferences.json. Selections also change the current simulation." Style="{StaticResource Muted}" Margin="0,14,0,0" /></StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Collection &amp; privacy" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Refresh: 1 second. Live chart retention: 120 samples. Recorder chart: latest 600 samples. Recording limit: 86,400 samples. Recording is manual; metrics are saved only when you export. Application logs are local and capped at approximately 1 MB plus one previous file." Style="{StaticResource Muted}" Margin="0,12,0,0" /></StackPanel></Border>
 </StackPanel>
</UserControl>
