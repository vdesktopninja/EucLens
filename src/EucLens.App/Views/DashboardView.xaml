<UserControl x:Class="EucLens.App.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:EucLens.App.Presentation" xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
 <StackPanel>
  <TextBlock Text="SESSION OVERVIEW" Style="{StaticResource Heading}" />
  <WrapPanel Margin="0,0,0,8"><TextBlock Text="{Binding Monitor.SessionIdentity}" TextWrapping="Wrap" Margin="0,0,12,0" /><TextBlock Text="Connection:" Style="{StaticResource Muted}" Margin="0,0,4,0" VerticalAlignment="Center" /><TextBlock Text="{Binding Monitor.ConnectionHealth}" Style="{StaticResource HealthValue}" Margin="0,0,12,0" /><TextBlock Text="Graphics:" Style="{StaticResource Muted}" Margin="0,0,4,0" VerticalAlignment="Center" /><TextBlock Text="{Binding Monitor.GraphicsHealth}" Style="{StaticResource HealthValue}" Margin="0,0,12,0" /><TextBlock Text="Guest:" Style="{StaticResource Muted}" Margin="0,0,4,0" VerticalAlignment="Center" /><TextBlock Text="{Binding Monitor.GuestHealth}" Style="{StaticResource HealthValue}" /></WrapPanel>
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource PanelRadius}" Margin="0,0,8,8"><ItemsControl ItemsSource="{Binding Monitor.OverviewCards}" Style="{StaticResource MetricStrip}" /></Border>
  <WrapPanel><StackPanel Margin="0,0,0,8"><TextBlock Text="Data source" Style="{StaticResource Muted}" /><ComboBox Width="200" ItemsSource="{Binding Monitor.Modes}" SelectedItem="{Binding Monitor.SelectedMode}" DisplayMemberPath="Label" AutomationProperties.Name="Monitoring mode" /></StackPanel><StackPanel Margin="0,0,16,8" Visibility="{Binding Monitor.IsReal, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding Monitor.ProtocolDetail}"><TextBlock Text="Detected protocol" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Monitor.ProtocolDisplay}" FontWeight="SemiBold" Margin="0,10,0,0" AutomationProperties.Name="Detected protocol" /></StackPanel><StackPanel Margin="0,0,0,8" Visibility="{Binding Monitor.IsDemo, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Demo protocol" Style="{StaticResource Muted}" /><ComboBox Width="200" ItemsSource="{Binding Monitor.Protocols}" SelectedItem="{Binding Monitor.SelectedProtocol}" DisplayMemberPath="Label" AutomationProperties.Name="Simulated protocol" /></StackPanel><StackPanel Margin="0,0,0,8" Visibility="{Binding Monitor.IsDemo, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Demo scenario" Style="{StaticResource Muted}" /><ComboBox Width="200" ItemsSource="{Binding Monitor.Scenarios}" SelectedItem="{Binding Monitor.SelectedScenario}" DisplayMemberPath="Label" AutomationProperties.Name="Demo scenario" /></StackPanel><StackPanel Margin="0,0,0,8"><TextBlock Text="Workload" Style="{StaticResource Muted}" /><ComboBox Width="200" ItemsSource="{Binding Monitor.Workloads}" SelectedItem="{Binding Monitor.SelectedWorkload}" DisplayMemberPath="Label" AutomationProperties.Name="Workload context" /></StackPanel></WrapPanel>
  <ui:AdaptiveColumnsPanel MinimumColumnWidth="340" MaximumColumns="2"><Border Style="{StaticResource ChartSurface}"><StackPanel><WrapPanel><TextBlock Text="Network / connection" FontWeight="SemiBold" Margin="0,0,12,0" /><TextBlock Text="{Binding Monitor.NetworkReadout}" Style="{StaticResource Muted}" /></WrapPanel><TextBlock Text="RTT · ms · 120 samples · 1 Hz" Style="{StaticResource Muted}" Margin="0,4,0,8" /><lvc:CartesianChart Series="{Binding Monitor.RttSeries}" XAxes="{Binding Monitor.TimeAxes}" YAxes="{Binding Monitor.RttAxes}" AnimationsSpeed="{Binding Monitor.ChartAnimation}" Height="{StaticResource ChartHeight}" Background="{DynamicResource ChartBackgroundBrush}" ui:ChartTheme.Text="{DynamicResource MutedBrush}" ui:ChartTheme.Surface="{DynamicResource SurfaceBrush}" ui:ChartTheme.Grid="{DynamicResource ChartGridBrush}" ui:ChartTheme.Line="{DynamicResource AccentBrush}" AutomationProperties.Name="Network / connection history" /></StackPanel></Border><Border Style="{StaticResource ChartSurface}"><StackPanel><WrapPanel><TextBlock Text="Graphics / frame delivery" FontWeight="SemiBold" Margin="0,0,12,0" /><TextBlock Text="{Binding Monitor.GraphicsReadout}" Style="{StaticResource Muted}" /></WrapPanel><TextBlock Text="Frame delivery · FPS · 120 samples · 1 Hz" Style="{StaticResource Muted}" Margin="0,4,0,8" /><lvc:CartesianChart Series="{Binding Monitor.FpsSeries}" XAxes="{Binding Monitor.FpsTimeAxes}" YAxes="{Binding Monitor.FpsAxes}" AnimationsSpeed="{Binding Monitor.ChartAnimation}" Height="{StaticResource ChartHeight}" Background="{DynamicResource ChartBackgroundBrush}" ui:ChartTheme.Text="{DynamicResource MutedBrush}" ui:ChartTheme.Surface="{DynamicResource SurfaceBrush}" ui:ChartTheme.Grid="{DynamicResource ChartGridBrush}" ui:ChartTheme.Line="{DynamicResource ChartSecondaryBrush}" AutomationProperties.Name="Graphics / frame delivery history" /></StackPanel></Border></ui:AdaptiveColumnsPanel>
  <ui:AdaptiveColumnsPanel MinimumColumnWidth="250" MaximumColumns="4"><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Connection" FontWeight="SemiBold" Margin="0,0,0,8" /><ItemsControl ItemsSource="{Binding Monitor.ConnectionCards}" Style="{StaticResource MetricRows}" /></StackPanel></Border><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Graphics" FontWeight="SemiBold" Margin="0,0,0,8" /><ItemsControl ItemsSource="{Binding Monitor.GraphicsCards}" Style="{StaticResource MetricRows}" /></StackPanel></Border><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="GPU" FontWeight="SemiBold" Margin="0,0,0,8" /><ItemsControl ItemsSource="{Binding Monitor.GpuCards}" Style="{StaticResource MetricRows}" /></StackPanel></Border><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="System" FontWeight="SemiBold" Margin="0,0,0,8" /><ItemsControl ItemsSource="{Binding Monitor.SystemCards}" Style="{StaticResource MetricRows}" /></StackPanel></Border></ui:AdaptiveColumnsPanel>
 </StackPanel>
</UserControl>
