<UserControl x:Class="EucLens.App.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
 <StackPanel>
  <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Your session, in focus" Style="{StaticResource Heading}" /><TextBlock Text="Explore connection, graphics and resource trends in a simulated VDI session." Style="{StaticResource Muted}" /></StackPanel><Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,12,0" Padding="18,12"><StackPanel><TextBlock Text="SESSION HEALTH · DEMO" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Monitor.Health}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Monitor.Health}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger><DataTrigger Binding="{Binding Monitor.Health}" Value="Critical"><Setter Property="Foreground" Value="#ED7373" /></DataTrigger><DataTrigger Binding="{Binding Monitor.Health}" Value="Unavailable"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border></Grid>
  <Border Style="{StaticResource Card}"><WrapPanel><StackPanel><TextBlock Text="Simulated protocol" Style="{StaticResource Muted}" /><ComboBox ItemsSource="{Binding Monitor.Protocols}" SelectedItem="{Binding Monitor.SelectedProtocol}" DisplayMemberPath="Label" AutomationProperties.Name="Simulated protocol" /></StackPanel><StackPanel><TextBlock Text="Demo scenario" Style="{StaticResource Muted}" /><ComboBox ItemsSource="{Binding Monitor.Scenarios}" SelectedItem="{Binding Monitor.SelectedScenario}" DisplayMemberPath="Label" AutomationProperties.Name="Demo scenario" /></StackPanel><StackPanel><TextBlock Text="Workload context" Style="{StaticResource Muted}" /><ComboBox ItemsSource="{Binding Monitor.Workloads}" SelectedItem="{Binding Monitor.SelectedWorkload}" DisplayMemberPath="Label" AutomationProperties.Name="Workload context" /></StackPanel></WrapPanel></Border>
  <ItemsControl ItemsSource="{Binding Monitor.OverviewCards}" ItemTemplate="{StaticResource MetricTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Connection responsiveness" FontWeight="SemiBold" /><TextBlock Text="Demo RTT · last 120 samples" Style="{StaticResource Muted}" Margin="0,6,0,12" /><lvc:CartesianChart Series="{Binding Monitor.RttSeries}" XAxes="{Binding Monitor.TimeAxes}" YAxes="{Binding Monitor.RttAxes}" AnimationsSpeed="{Binding Monitor.ChartAnimation}" Height="220" /></StackPanel></Border>
   <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Frame delivery" FontWeight="SemiBold" /><TextBlock Text="Demo FPS · interpret with workload context" Style="{StaticResource Muted}" Margin="0,6,0,12" /><lvc:CartesianChart Series="{Binding Monitor.FpsSeries}" XAxes="{Binding Monitor.FpsTimeAxes}" YAxes="{Binding Monitor.FpsAxes}" AnimationsSpeed="{Binding Monitor.ChartAnimation}" Height="220" /></StackPanel></Border>
  </Grid>
  <TextBlock Text="Connection" Style="{StaticResource Section}" /><ItemsControl ItemsSource="{Binding Monitor.ConnectionCards}" Style="{StaticResource MetricGrid}" />
  <TextBlock Text="Graphics &amp; encoding" Style="{StaticResource Section}" /><ItemsControl ItemsSource="{Binding Monitor.GraphicsCards}" Style="{StaticResource MetricGrid}" />
  <TextBlock Text="GPU resources" Style="{StaticResource Section}" /><ItemsControl ItemsSource="{Binding Monitor.GpuCards}" Style="{StaticResource MetricGrid}" />
  <TextBlock Text="System resources" Style="{StaticResource Section}" /><ItemsControl ItemsSource="{Binding Monitor.SystemCards}" Style="{StaticResource MetricGrid}" />
  <TextBlock Text="Session information" Style="{StaticResource Section}" /><ItemsControl ItemsSource="{Binding Monitor.SessionCards}" Style="{StaticResource MetricGrid}" />
 </StackPanel>
</UserControl>
