<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <IsPublishable>true</IsPublishable>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification-area icon (NotifyIcon); no WinForms windows are used. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WFO0003 asks WinForms apps to move DPI settings out of the manifest; this is a WPF app and the manifest owns PerMonitorV2. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>EucLens</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\EucLens.ico</ApplicationIcon>
    <!-- The file description Windows shows (Explorer → Properties → Details, Task Manager). Product, company, copyright and version come from Directory.Build.props. -->
    <AssemblyTitle>EUC Lens - Remote Session Performance Diagnostics</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <!-- Generated by tools/branding/generate_icons.py; the vector master is assets/branding/euclens-icon.svg. -->
    <Resource Include="Assets\EucLens.ico" />
    <Resource Include="Assets\EucLens-logo.png" />
    <Resource Include="Assets\Tray\*.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../EucLens.Core/EucLens.Core.csproj" />
    <ProjectReference Include="../EucLens.Providers/EucLens.Providers.csproj" />
    <ProjectReference Include="../EucLens.Diagnostics/EucLens.Diagnostics.csproj" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
  </ItemGroup>
</Project>
