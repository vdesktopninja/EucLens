<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Only the desktop executable is a shipping publish target; libraries still build and tests still run. -->
    <IsPublishable>false</IsPublishable>
    <DebugType>embedded</DebugType>
    <!-- The one place the application version is set. Assemblies carry it and AppVersion reads it; recordings record it. -->
    <Version>0.5.1</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Application identity: written once here, carried by every assembly (Windows Explorer → Properties → Details) and read back by AppIdentity for the About page. -->
    <Product>EUC Lens</Product>
    <Description>Remote Session Performance Diagnostics</Description>
    <!-- Owner-confirmed public identity: the author, the professional brand (the publisher shown by Windows) and the website. The copyright line stays the repository's own (LICENSE). -->
    <Authors>Dominik Jakubowski</Authors>
    <Company>VDI Ninja</Company>
    <EucLensWebsite>https://vdesktop.ninja</EucLensWebsite>
    <Copyright>Copyright (c) 2026 EUC Lens contributors</Copyright>
    <RepositoryUrl>https://github.com/vdesktopninja/RDA</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <!-- RepositoryUrl is added to the assembly metadata by the SDK itself. -->
    <AssemblyMetadata Include="License" Value="$(PackageLicenseExpression)" />
    <AssemblyMetadata Include="Author" Value="$(Authors)" />
    <AssemblyMetadata Include="Website" Value="$(EucLensWebsite)" />
    <!-- Set by the build (CI passes -p:EucLensCommit=<sha>); absent in a local build, which the About page then says. -->
    <AssemblyMetadata Include="CommitSha" Value="$(EucLensCommit)" Condition="'$(EucLensCommit)' != ''" />
  </ItemGroup>
</Project>
